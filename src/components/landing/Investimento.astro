---
import type { CollectionEntry } from "astro:content";
import { whatsappUrlWithText } from "../../lib/whatsapp";
import Icon from "../icons/Icon.astro";
import SectionHeader from "./SectionHeader.astro";

type ProductData = CollectionEntry<"products">["data"];
type Lote = NonNullable<ProductData["lotes"]>[number];

export interface Props {
	investimento: ProductData["investimento"];
	lotes?: ProductData["lotes"];
}

const { investimento, lotes } = Astro.props;
const loteList = lotes as Lote[] | undefined;
const ctaHref = whatsappUrlWithText(investimento.cta.whatsappMessage);
const hasCheckout = Boolean(investimento.cta.checkoutUrl);

/** `preco` is pt-BR formatted ("3.500"); the count-up needs the integer and
 *  re-localises on every frame. Falls back to no animation when the price is
 *  not a plain number (e.g. a future "sob consulta"). */
const precoNumero = Number(investimento.preco.replace(/\D/g, "")) || null;

const statusLabel: Record<"encerrado" | "ativo" | "futuro", string> = {
	encerrado: "Encerrado",
	ativo: "Ativo",
	futuro: "Em breve",
};
---

{/*
	The page's climax and the ONLY pedestal: the single `glass-card-bright`
	plus the gold halo (DESIGN.md § 10 — the brightest glass is reserved for
	one moment per page). The pointer-glow lives here too, for the same reason.

	Dual conversion path, gated on `checkoutUrl`: while it is null WhatsApp
	holds the gold primary slot. When the official enrolment link is registered
	in otb.json, checkout takes gold and WhatsApp becomes the consultative
	outline action — no provisional URL is ever invented.
*/}
<section
	id="investimento"
	class="band-base relative isolate overflow-hidden py-section"
	aria-labelledby="investimento-heading"
>
	<div class="landing-mesh-bg absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>

	<div class="mx-auto max-w-6xl px-6 lg:px-8">
		<div class="grid grid-cols-1 items-center gap-14 lg:grid-cols-12 lg:gap-16">
			<div class="lg:col-span-6" data-reveal="left">
				<SectionHeader
					headingId="investimento-heading"
					numeral="09"
					kicker="Investimento"
					headline={investimento.headline}
					highlight={investimento.highlight}
					descricao={investimento.descricao}
				/>

				<ul
					class="mt-block grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2"
					aria-label="O que está incluído"
				>
					{investimento.beneficios.map((b) => (
						<li class="flex items-start gap-3 text-meta text-text-secondary">
							<span
								class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-gold-tint-10 text-gold"
								aria-hidden="true"
							>
								<Icon name="check" size={12} strokeWidth={2.5} />
							</span>
							<span>{b}</span>
						</li>
					))}
				</ul>

				<p
					class="mt-8 font-display text-h3 italic leading-snug text-text-primary/85"
				>
					{investimento.tagline}
				</p>

				{loteList && loteList.length > 0 && (
					<div class="mt-10" aria-label="Lotes de investimento">
						<div class="text-kicker uppercase tracking-kicker text-text-muted">
							Lotes escalonados
						</div>
						<ol
							class="mt-4 divide-y divide-[color-mix(in_srgb,var(--color-gold)_16%,transparent)] border-y border-[color-mix(in_srgb,var(--color-gold)_16%,transparent)]"
						>
							{loteList.map((l) => {
								const isActive = l.status === "ativo";
								const isPast = l.status === "encerrado";
								return (
									<li
										class={`flex flex-col gap-2 py-3.5 sm:flex-row sm:items-center sm:justify-between sm:gap-4 ${isPast ? "opacity-55" : ""} ${isActive ? "pl-3.5 -ml-3.5 border-l-2 border-crimson-mid-45" : ""}`}
										aria-current={isActive ? "true" : undefined}
									>
										<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
											<span
												class={`inline-flex h-6 shrink-0 items-center justify-center whitespace-nowrap rounded-full px-3 text-kicker font-semibold uppercase tracking-kicker ${isActive ? "border border-crimson-mid-45 bg-crimson-tint-16 text-gold" : isPast ? "bg-text-muted/20 text-text-muted" : "border border-gold/40 text-gold"}`}
											>
												{statusLabel[l.status]}
											</span>
											<span
												class="whitespace-nowrap font-display text-body font-semibold text-text-primary"
											>
												{l.label}
											</span>
										</div>
										<div
											class="flex flex-wrap items-baseline gap-x-2 gap-y-1 tabular-nums sm:justify-end sm:text-right"
										>
											<span class="text-meta text-text-muted">{l.moeda}</span>
											<span
												class={`font-sans text-lg font-bold tracking-tight ${isActive ? "text-gradient-gold" : "text-text-secondary"}`}
											>
												{l.preco}
											</span>
											{l.validade && (
												<span
													class="w-full text-kicker uppercase tracking-kicker text-text-muted sm:w-auto"
												>
													{l.validade}
												</span>
											)}
										</div>
									</li>
								);
							})}
						</ol>
					</div>
				)}
			</div>

			<div class="lg:col-span-6" data-reveal="right" data-reveal-delay="2">
				<div
					class="glass-card-bright gold-pulse-glow relative rounded-3xl p-8 shadow-(--shadow-halo-gold) sm:p-10"
					data-glow-card
					data-tilt
				>
					<div class="text-kicker uppercase tracking-kicker text-text-muted">
						Investimento à vista
					</div>
					<div class="mt-3 flex items-baseline gap-2 tabular-nums">
						<span class="font-sans text-xl font-medium text-text-secondary">
							{investimento.moeda}
						</span>
						<span
							class="font-display text-6xl font-extrabold tracking-tight text-gradient-gold sm:text-7xl"
							data-count={precoNumero ?? undefined}
							data-count-format={precoNumero ? "pt" : undefined}
						>
							{investimento.preco}
						</span>
					</div>
					{investimento.escassez && (
						<p class="mt-4 flex items-start gap-2 text-meta text-text-secondary">
							<Icon
								name="alert-circle"
								size={14}
								strokeWidth={2}
								class="mt-0.5 shrink-0 text-gold/60"
								aria-hidden="true"
							/>
							<span>{investimento.escassez}</span>
						</p>
					)}

					<div
						class="mt-8 border-t border-[color-mix(in_srgb,var(--color-gold)_22%,transparent)] pt-6"
					>
						<div class="text-kicker uppercase tracking-kicker text-text-muted">
							Parcelamento
						</div>
						<ul class="mt-3 space-y-2 text-meta text-text-secondary">
							{investimento.parcelamento.map((p) => (
								<li class="flex min-w-0 items-start gap-2.5">
									<Icon
										name="chevron-right"
										size={14}
										strokeWidth={2.25}
										class="mt-0.5 shrink-0 text-gold/60"
										aria-hidden="true"
									/>
									<span class="min-w-0 wrap-break-word">{p}</span>
								</li>
							))}
						</ul>
					</div>

					<div class="mt-10 space-y-3">
						{hasCheckout && investimento.cta.checkoutUrl ? (
							<>
								<a
									href={investimento.cta.checkoutUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="group flex min-h-[52px] w-full items-center justify-center gap-3 rounded-full bg-gold px-6 font-semibold text-navy shadow-(--shadow-halo-gold) transition-transform duration-300 hover:scale-[1.02] focus-visible:scale-[1.02]"
								>
									<span>{investimento.cta.secondaryLabel ?? "Garantir vaga"}</span>
									<Icon
										name="arrow-right"
										size={18}
										strokeWidth={2.25}
										class="transition-transform duration-300 group-hover:translate-x-1"
									/>
								</a>
								<a
									href={ctaHref}
									target="_blank"
									rel="noopener noreferrer"
									class="flex min-h-[52px] w-full items-center justify-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--color-gold)_45%,transparent)] px-6 text-sm font-medium text-text-primary transition-colors hover:border-gold hover:text-gold"
									aria-label={`${investimento.cta.label} — atendimento consultivo`}
								>
									<Icon name="message-circle" size={18} strokeWidth={2.25} />
									<span>{investimento.cta.label}</span>
								</a>
							</>
						) : (
							<a
								href={ctaHref}
								target="_blank"
								rel="noopener noreferrer"
								class="group flex min-h-[52px] w-full items-center justify-center gap-3 rounded-full bg-gold px-6 font-semibold text-navy shadow-(--shadow-halo-gold) transition-transform duration-300 hover:scale-[1.02] focus-visible:scale-[1.02]"
								aria-label={`${investimento.cta.label} no WhatsApp`}
							>
								<Icon name="message-circle" size={20} strokeWidth={2.25} />
								<span>{investimento.cta.label}</span>
								<Icon
									name="arrow-right"
									size={18}
									strokeWidth={2.25}
									class="transition-transform duration-300 group-hover:translate-x-1"
								/>
							</a>
						)}
					</div>
				</div>
			</div>
		</div>
	</div>

	{/* Pointer-glow: sets --mouse-x/y on the pedestal. Decorative, so it bails
	    out entirely under prefers-reduced-motion. */}
	<script is:inline>
		(() => {
			try {
				const cards = document.querySelectorAll("[data-glow-card]");
				if (!cards.length) return;
				const reduceMotion =
					typeof window.matchMedia === "function" &&
					window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				if (reduceMotion) return;
				cards.forEach((card) => {
					if (!(card instanceof HTMLElement)) return;
					card.addEventListener("pointermove", (e) => {
						const rect = card.getBoundingClientRect();
						card.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
						card.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
					});
				});
			} catch {
				/* decorative; failure is acceptable */
			}
		})();
	</script>
</section>
