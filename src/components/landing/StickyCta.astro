---
import { whatsappUrlWithText } from "../../lib/whatsapp";
import Icon from "../icons/Icon.astro";

export interface Props {
	/** Derived from the active lote — never hardcoded copy. */
	info: string;
	label: string;
	whatsappMessage: string;
	/** Null until the official enrolment link is registered (WS-73). */
	checkoutUrl?: string | null;
	checkoutLabel?: string;
	/** Countdown strip. Both arrive together or not at all — the prefix without
	 *  a target would render a dangling "faltam". */
	countdownPrefixo?: string;
	countdownTarget?: string;
}

const {
	info,
	label,
	whatsappMessage,
	checkoutUrl,
	checkoutLabel,
	countdownPrefixo,
	countdownTarget,
} = Astro.props;

const hasCountdown = Boolean(countdownPrefixo && countdownTarget);

const whatsappHref = whatsappUrlWithText(whatsappMessage);
const hasCheckout = Boolean(checkoutUrl);
---

{/*
	Conversion bar. Owns the bottom edge at EVERY width since v2 — the round
	floating button retracts at the same threshold (global.css
	`[data-float-wa].is-retracted`) so the two never share the corner. Body
	padding-bottom is reserved in global.css from first paint, never injected on
	scroll (CLS).

	It only appears once 80% of the first fold has scrolled away, so the hero's
	fact rail is never covered.

	Dual path: while `checkoutUrl` is null the WhatsApp action stays gold and
	primary. The moment the official link lands in otb.json, checkout takes the
	gold slot and WhatsApp demotes to the consultative outline action.
*/}
<div
	class="sticky-cta fixed inset-x-0 bottom-0 z-50 border-t border-[color-mix(in_srgb,var(--color-gold)_20%,transparent)] bg-[color-mix(in_srgb,var(--color-navy-deep)_95%,transparent)] backdrop-blur-md"
	data-sticky-cta
>
	{/* The surface spans the viewport; only the content is contained. Putting
	    both on the same box left the bar floating with the page showing through
	    the gutters. */}
	<div
		class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 lg:px-8"
		style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));"
	>
		<div class="min-w-0 shrink">
			<p class="text-meta font-medium tabular-nums text-text-secondary">
				{info}
			</p>
			{hasCountdown && (
				<p
					class="mt-0.5 hidden text-kicker font-semibold uppercase tracking-kicker tabular-nums text-text-muted sm:block"
					data-cd-target={countdownTarget}
				>
					{countdownPrefixo}{" "}
					<span class="text-gold" data-cd-mini>000d 00h 00m</span>
				</p>
			)}
		</div>

		{/* `sticky_mobile` is the historical origin id: it predates the bar being
		    shown on desktop too. Renaming it would split the column in the leads
		    sheet and in the Apps Script allowlist, so the name stays and this
		    comment carries the meaning. */}
		{hasCheckout && checkoutUrl ? (
			<span class="flex shrink-0 items-center gap-2">
				<button
					type="button"
					data-lead-cta="sticky_mobile"
					data-whatsapp-url={whatsappHref}
					class="inline-flex min-h-11 items-center justify-center rounded-full border border-[color-mix(in_srgb,var(--color-gold)_45%,transparent)] px-4 text-sm font-medium text-text-primary"
					aria-label={`${label} no WhatsApp`}
				>
					<Icon name="message-circle" size={18} strokeWidth={2.25} />
				</button>
				<a
					href={checkoutUrl}
					target="_blank"
					rel="noopener noreferrer"
					data-shine
					class="inline-flex min-h-11 min-w-[9rem] items-center justify-center gap-2 rounded-full bg-gold px-5 text-sm font-semibold text-navy"
				>
					{checkoutLabel ?? "Garantir vaga"}
					<Icon name="arrow-right" size={16} strokeWidth={2.25} />
				</a>
			</span>
		) : (
			<button
				type="button"
				data-lead-cta="sticky_mobile"
				data-whatsapp-url={whatsappHref}
				data-shine
				class="inline-flex min-h-11 min-w-[10rem] shrink-0 items-center justify-center gap-2 rounded-full bg-gold px-5 text-sm font-semibold text-navy"
				aria-label={`${label} no WhatsApp`}
			>
				<Icon name="message-circle" size={18} strokeWidth={2.25} />
				{label}
			</button>
		)}
	</div>
</div>
