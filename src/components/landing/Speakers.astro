---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { resolveImage } from "../../lib/images";
import Icon from "../icons/Icon.astro";
import SectionHeader from "./SectionHeader.astro";

export interface Props {
	speakers: CollectionEntry<"products">["data"]["speakers"];
}

const { speakers } = Astro.props;
---

{/*
	Editorial portraits, 4:5, hard corners — not circular avatars with a double
	conic ring. The grid is 4 columns to match the roster: it used to be 5 with
	4 entries, leaving a permanent empty cell.

	The Instagram link is a labelled text link, not the whole card: making the
	portrait an outbound target sent traffic out of the funnel on tap.
*/}
<section
	id="speakers"
	class="band-base relative py-section"
	aria-labelledby="speakers-heading"
>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<SectionHeader
			headingId="speakers-heading"
			numeral="08"
			kicker="Especialistas"
			headline={speakers.headline}
			highlight={speakers.highlight}
			descricao={speakers.descricao}
		/>

		<ul
			class="mt-block grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6"
		>
			{speakers.lista.map((s, idx) => (
				<li data-reveal="up" data-reveal-delay={String(Math.min(idx + 1, 6))}>
					<div
						class="aspect-[4/5] overflow-hidden rounded-plate border border-[color-mix(in_srgb,var(--color-gold)_25%,transparent)]"
					>
						<Picture
							src={resolveImage(s.foto)}
							alt={`Retrato profissional de ${s.nome}.`}
							formats={["avif", "webp"]}
						fallbackFormat="jpeg"
							widths={[320, 480]}
							sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw"
							loading="lazy"
							fetchpriority="low"
							decoding="async"
							class="h-full w-full object-cover object-top"
						/>
					</div>

					<div
						class="mt-4 border-t border-[color-mix(in_srgb,var(--color-gold)_20%,transparent)] pt-4"
					>
						<h3 class="font-serif text-h3 font-semibold text-text-primary">
							{s.nome}
						</h3>
						<p
							class="mt-1 text-kicker font-semibold uppercase tracking-kicker text-gold"
						>
							{s.area}
						</p>
						<p class="mt-3 text-meta text-text-secondary">{s.bio}</p>
						<a
							href={s.instagram}
							target="_blank"
							rel="noopener noreferrer"
							class="mt-4 inline-flex min-h-11 items-center gap-2 text-meta font-medium text-text-muted transition-colors hover:text-gold focus-visible:text-gold"
							aria-label={`Perfil do Instagram de ${s.nome}`}
						>
							<Icon name="instagram" size={16} strokeWidth={1.75} aria-hidden="true" />
							Instagram
						</a>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>
