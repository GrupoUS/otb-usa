---
import type { CollectionEntry } from "astro:content";
import Icon from "../icons/Icon.astro";

export interface Props {
	speakers: CollectionEntry<"products">["data"]["speakers"];
}

const { speakers } = Astro.props;
---

<section id="speakers" class="relative py-28 sm:py-32" aria-labelledby="speakers-heading">
	<!-- subtle USA-accent ambient background -->
	<div class="pointer-events-none absolute inset-0 -z-10 landing-mesh-usa opacity-30" aria-hidden="true"></div>

	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="mx-auto max-w-3xl text-center" data-reveal="up">
			<span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.32em] text-gold">
				<span class="h-px w-10 bg-gold/60"></span>
				Especialistas
			</span>
			<h2
				id="speakers-heading"
				class="mt-5 font-serif text-3xl font-bold leading-[1.1] tracking-tight text-balance sm:text-4xl md:text-5xl"
			>
				<span class="text-text-primary">{speakers.headline}</span>
				{speakers.highlight && (
					<span class="mt-2 block text-gradient-gold">{speakers.highlight}</span>
				)}
			</h2>
			<p class="mt-4 text-base text-text-muted sm:text-lg">{speakers.descricao}</p>
		</div>

		<ul class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
			{speakers.lista.map((s, idx) => (
				<li
					class="group flex flex-col items-center rounded-2xl border border-[color-mix(in_srgb,var(--color-gold)_14%,transparent)] bg-[color-mix(in_srgb,var(--color-navy-light)_55%,transparent)] px-5 pb-8 pt-8 text-center card-glow-hover"
					data-reveal="up"
					data-reveal-delay={String(Math.min(idx + 1, 6))}
				>
					<a
						href={s.instagram}
						target="_blank"
						rel="noopener noreferrer"
						class="relative mb-6 inline-block transition-transform duration-300 group-hover:scale-[1.05] focus-visible:scale-[1.05]"
						aria-label={`Perfil do Instagram de ${s.nome}`}
					>
						<!-- gold ring on hover -->
						<span
							class="absolute -inset-1.5 rounded-full opacity-0 blur-sm transition-opacity duration-500 group-hover:opacity-100"
							style="background: conic-gradient(from 180deg at 50% 50%, var(--color-gold-light) 0deg, var(--color-gold) 120deg, var(--color-gold-dark) 240deg, var(--color-gold-light) 360deg);"
							aria-hidden="true"
						></span>
						<span
							class="absolute -inset-1 rounded-full opacity-60 blur-sm transition-opacity duration-500 group-hover:opacity-0"
							style="background: conic-gradient(from 180deg at 50% 50%, var(--color-gold) 0deg, var(--color-gold-light) 120deg, var(--color-gold-dark) 240deg, var(--color-gold) 360deg);"
							aria-hidden="true"
						></span>
						<span class="relative block h-32 w-32 overflow-hidden rounded-full border-2 border-[color-mix(in_srgb,var(--color-gold)_45%,transparent)] bg-navy-light transition-[border-color] duration-300 group-hover:border-[color-mix(in_srgb,var(--color-gold)_65%,transparent)]">
							<img
								src={s.foto}
								alt={`Retrato profissional de ${s.nome}.`}
								width="256"
								height="256"
								loading="lazy"
								fetchpriority="low"
								decoding="async"
								class="h-full w-full object-cover"
							/>
						</span>
						<!-- instagram badge — gold accent -->
						<span
							class="absolute -bottom-2 right-0 inline-flex h-7 w-7 items-center justify-center rounded-full border border-gold-mid-35 bg-navy text-gold shadow-md transition-colors duration-300 group-hover:border-[color-mix(in_srgb,var(--color-gold)_45%,transparent)] group-hover:bg-gold-tint-10"
							aria-hidden="true"
						>
							<Icon name="instagram" size={14} />
						</span>
					</a>

					<h3 class="wrap-break-word font-serif text-lg font-semibold text-text-primary">{s.nome}</h3>

					<!-- area badge — gold pill -->
					<span class="mt-2 inline-flex items-center rounded-full border border-gold-mid-35 bg-gold-tint-10 px-3 py-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-gold">
						{s.area}
					</span>

					<p class="mt-3 wrap-break-word px-1 text-sm leading-relaxed text-text-muted">{s.bio}</p>
				</li>
			))}
		</ul>
	</div>
</section>
