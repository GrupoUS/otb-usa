---
import type { CollectionEntry } from "astro:content";
import { whatsappPartnerUrl } from "../../lib/whatsapp";
import Icon, { type IconName } from "../icons/Icon.astro";
import SectionHeader from "./SectionHeader.astro";

type ProductData = CollectionEntry<"products">["data"];
type Partner = NonNullable<ProductData["parceiros"]>["lista"][number];

export interface Props {
	parceiros: NonNullable<ProductData["parceiros"]>;
}

const { parceiros } = Astro.props;
const partnerList = parceiros.lista as Partner[];

const partnerIcons: IconName[] = ["globe", "shield-check"];

const PARTNER_OPENING = "Olá! Vim do OTB Estados Unidos.";
---

{/*
	Appendix. Deliberately demoted: no glass, no hover glow, deep band. These
	links leave the funnel, so they must not compete with the primary CTA.
*/}
<section
	id="parceiros"
	class="band-deep relative py-section-tight"
	aria-labelledby="parceiros-heading"
>
	<div class="mx-auto max-w-6xl px-6 lg:px-8">
		<SectionHeader
			headingId="parceiros-heading"
			kicker="Apoio operacional"
			headline={parceiros.headline}
			descricao={parceiros.descricao}
		/>

		<ul
			class="mt-block divide-y divide-[color-mix(in_srgb,var(--color-gold)_14%,transparent)] border-y border-[color-mix(in_srgb,var(--color-gold)_14%,transparent)]"
		>
			{partnerList.map((p, idx) => (
				<li
					class="flex flex-col gap-4 py-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8"
					data-reveal="up"
					data-reveal-delay={String(idx + 1)}
				>
					<div class="flex min-w-0 items-start gap-4">
						<Icon
							name={partnerIcons[idx] ?? "users"}
							size={18}
							strokeWidth={1.75}
							class="mt-1 shrink-0 text-gold/70"
							aria-hidden="true"
						/>
						<div class="min-w-0">
							<h3 class="text-body font-semibold text-text-primary">{p.nome}</h3>
							<p class="mt-0.5 text-meta text-text-muted">{p.papel}</p>
							{p.descricao && (
								<p class="mt-2 max-w-xl text-meta text-text-secondary">
									{p.descricao}
								</p>
							)}
						</div>
					</div>

					<div class="flex shrink-0 flex-wrap items-center gap-3">
						{p.contato?.whatsapp && (
							<a
								href={whatsappPartnerUrl(p.contato.whatsapp, PARTNER_OPENING)}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex min-h-11 items-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--color-gold)_30%,transparent)] px-4 text-meta font-medium text-text-secondary transition-colors hover:border-gold hover:text-gold"
								aria-label={`Falar com ${p.nome} no WhatsApp`}
							>
								<Icon name="message-circle" size={15} strokeWidth={2} aria-hidden="true" />
								{p.contato.whatsapp}
							</a>
						)}
						{p.contato?.instagram && (
							<a
								href={p.contato.instagram}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex min-h-11 items-center gap-2 text-meta font-medium text-text-muted transition-colors hover:text-gold"
								aria-label={`Instagram de ${p.nome}`}
							>
								<Icon name="instagram" size={15} strokeWidth={2} aria-hidden="true" />
								Instagram
							</a>
						)}
					</div>
				</li>
			))}
		</ul>
	</div>
</section>
