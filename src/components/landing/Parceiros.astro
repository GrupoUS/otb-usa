---
import type { CollectionEntry } from "astro:content";
import { whatsappPartnerUrl } from "../../lib/whatsapp";
import Icon, { type IconName } from "../icons/Icon.astro";

type ProductData = CollectionEntry<"products">["data"];
type Partner = NonNullable<ProductData["parceiros"]>["lista"][number];

export interface Props {
	parceiros: NonNullable<ProductData["parceiros"]>;
}

const { parceiros } = Astro.props;
const partnerList = parceiros.lista as Partner[];

const partnerIcons: IconName[] = ["globe", "shield-check"];

const PARTNER_OPENING = "Olá! Vim do OTB Estados Unidos.";
---

<section
	id="parceiros"
	class="relative isolate overflow-hidden py-24 sm:py-28"
	aria-labelledby="parceiros-heading"
>
	<div class="mx-auto max-w-6xl px-6 lg:px-8">
		<div class="max-w-3xl" data-reveal="up">
			<span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.32em] text-gold">
				<span class="h-px w-10 bg-gold/60"></span>
				Parceiros operacionais
			</span>
			<h2
				id="parceiros-heading"
				class="mt-5 font-serif text-3xl font-bold leading-[1.1] tracking-tight sm:text-4xl"
			>
				<span class="text-text-primary">{parceiros.headline}</span>
			</h2>
			{parceiros.descricao && (
				<p class="mt-6 max-w-2xl text-base leading-relaxed text-text-muted sm:text-lg">
					{parceiros.descricao}
				</p>
			)}
		</div>

		<ul class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2">
			{partnerList.map((p, idx) => (
				<li
					class="glass-card rounded-2xl p-7"
					data-reveal="up"
					data-reveal-delay={String(idx + 2)}
				>
					<div class="flex items-start gap-4">
						<div class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[color-mix(in_srgb,var(--color-gold)_35%,transparent)] bg-[color-mix(in_srgb,var(--color-gold)_10%,transparent)] text-gold">
							<Icon name={partnerIcons[idx] ?? "users"} size={20} strokeWidth={1.75} />
						</div>
						<div class="min-w-0">
							<h3 class="font-serif text-lg font-semibold leading-tight text-text-primary">
								{p.nome}
							</h3>
							<p class="mt-1 text-[11px] uppercase tracking-[0.22em] text-gold/80">
								{p.papel}
							</p>
						</div>
					</div>
					{p.descricao && (
						<p class="mt-4 text-sm leading-relaxed text-text-muted">{p.descricao}</p>
					)}
					{p.contato && (
						<div class="mt-5 flex flex-wrap gap-3">
							{p.contato.whatsapp && (
								<a
									href={whatsappPartnerUrl(p.contato.whatsapp, PARTNER_OPENING)}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--color-gold)_45%,transparent)] px-4 py-2 text-xs font-medium text-text-primary transition-colors hover:border-gold hover:text-gold"
									aria-label={`Falar com ${p.nome} no WhatsApp`}
								>
									<Icon name="message-circle" size={14} strokeWidth={2.25} />
									<span>{p.contato.whatsapp}</span>
								</a>
							)}
							{p.contato.instagram && (
								<a
									href={p.contato.instagram}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--color-gold)_45%,transparent)] px-4 py-2 text-xs font-medium text-text-primary transition-colors hover:border-gold hover:text-gold"
									aria-label={`Instagram de ${p.nome}`}
								>
									<Icon name="instagram" size={14} strokeWidth={2.25} />
									<span>Instagram</span>
								</a>
							)}
						</div>
					)}
				</li>
			))}
		</ul>
	</div>
</section>
