---
import type { CollectionEntry } from "astro:content";

export interface Props {
	certificacoes: NonNullable<
		CollectionEntry<"products">["data"]["certificacoes"]
	>;
	/** Accepted for caller compatibility; this proof strip is intentionally static. */
	controles?: CollectionEntry<"products">["data"]["certificacoesControles"];
}

const { certificacoes } = Astro.props;
---

{/* Static proof strip: certifications remain visible before the first scroll
    without a saturated moving band competing with the hero plate. */}
<section
	class="relative border-y border-edge bg-ink-raised py-5 sm:py-6"
	aria-label="Certificações do programa"
>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
			{certificacoes.map((item) => (
				<li class="border-l-2 border-crimson-mid-45 pl-4 text-kicker font-semibold uppercase leading-snug tracking-[0.16em] text-text-primary">
					{item}
				</li>
			))}
		</ul>
	</div>
</section>
