---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { resolveImage } from "../../lib/images";
import { whatsappUrlWithText } from "../../lib/whatsapp";
import Icon, { type IconName } from "../icons/Icon.astro";

export interface Props {
	hero: CollectionEntry<"products">["data"]["hero"];
	countdown?: CollectionEntry<"products">["data"]["countdown"];
}

const { hero, countdown } = Astro.props;
const ctaHref = whatsappUrlWithText(hero.cta.whatsappMessage);
const hasCheckout = Boolean(hero.cta.checkoutUrl);
const plate = resolveImage(hero.background.image);
---

<section
	id="topo"
	class="relative isolate flex min-h-[100svh] flex-col overflow-hidden"
	aria-labelledby="hero-heading"
>
	{/*
		Plate: a real <img>, not a CSS background — this is the LCP element and
		needs eager loading, a priority hint and intrinsic dimensions (CLS 0).

		`widths` must span the rendered box across DPRs: this is `sizes="100vw"`,
		so a laptop at 1440 CSS px already needs the 1600 step. Sharp's AVIF
		default is quality 50, which smears faces on a group photograph — hence
		the explicit value. Keep it lower here than on the lazy plates: this file
		is the LCP and pays its bytes on first paint.
	*/}
	{/*
		The parallax wrapper is overscanned by 12% on the block axis so the plate
		still covers the frame at either end of the travel. Its `transform` is
		reserved for the scroll offset — the image inside never transforms, which
		is what keeps the plate from jumping (stability.md § Debug triage).
	*/}
	<div
		class="absolute inset-x-0 -inset-y-[12%] -z-20"
		data-parallax
		data-speed="0.16"
		aria-hidden="true"
	>
		<Picture
			src={plate}
			alt=""
			formats={["avif", "webp"]}
			fallbackFormat="jpeg"
			widths={[640, 960, 1280, 1600]}
			quality={62}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			decoding="sync"
			aria-hidden="true"
			class="h-full w-full object-cover object-[center_32%]"
		/>
	</div>

	{/* Scrim: ink stays strongest behind the copy, then releases the real
	    classroom plate on the right. The crimson tail remains the approved
	    USA accent without turning the photograph into a color field. */}
	<div
		class="absolute inset-0 -z-10"
		aria-hidden="true"
		style="background: linear-gradient(102deg, transparent 54%, color-mix(in srgb, var(--color-crimson) 14%, transparent) 100%), linear-gradient(102deg, color-mix(in srgb, var(--color-ink-deep) 91%, transparent) 0%, color-mix(in srgb, var(--color-ink-deep) 68%, transparent) 43%, color-mix(in srgb, var(--color-ink-deep) 18%, transparent) 100%);"
	>
	</div>

	{/* Static washes keep depth in the fold without adding competing scroll
	    motion to the first paint. */}
	<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
		<div
			class="absolute -top-40 -left-32 h-[560px] w-[560px] rounded-full opacity-[0.08]"
			style="background: radial-gradient(circle, var(--color-gold) 0%, transparent 70%);"
		>
		</div>
		<div
			class="absolute -bottom-48 -right-40 h-[660px] w-[660px] rounded-full opacity-[0.12]"
			style="background: radial-gradient(circle, var(--color-crimson-bright) 0%, transparent 66%);"
		>
		</div>
	</div>

	{/* The fold keeps its final layout during scroll; the plate and sections
	    provide enough movement without fading the LCP content away. */}
	<div
		class="mx-auto flex w-full max-w-7xl flex-1 items-center px-6 pt-24 pb-10 lg:px-8 lg:pt-28"
		data-hero-fold
	>
		<div class="w-full min-w-0 max-w-4xl">
			{hero.eyebrow && (
				<p
					class="flex items-center gap-3.5 text-kicker font-semibold uppercase tracking-kicker text-gold tabular-nums"
					data-enter="1"
				>
					{/* Crimson rule — the sanctioned date/place marker role, and the
					    first thing that ties the fold to "Estados Unidos". */}
					<span
						class="h-0.5 w-11 shrink-0"
						style="background-color: var(--color-crimson-bright);"
						aria-hidden="true"></span>
					{hero.eyebrow}
				</p>
			)}

			<h1
				id="hero-heading"
				class="mt-6 font-display text-display font-bold text-balance"
				data-enter="2"
			>
				<span class="block text-text-primary">{hero.headline}</span>
				{hero.highlight && (
					<span class="mt-1 block text-text-primary">{hero.highlight}</span>
				)}
			</h1>

			<p
				class="mt-7 max-w-2xl text-lede font-light text-text-secondary"
				data-enter="3"
			>
				{hero.subheadline}
			</p>

			<ul
				class="mt-8 hidden flex-wrap gap-2.5 sm:flex lg:flex-nowrap"
				data-enter="4"
				aria-label="Diferenciais do programa"
			>
				{hero.badges.map((badge) => (
					<li
						class="inline-flex items-center whitespace-nowrap rounded-full border border-edge bg-ink-soft-70 px-3.5 py-1.5 text-meta font-medium text-text-primary/90"
					>
						{badge}
					</li>
				))}
			</ul>

			{/*
				Action row. One gold CTA and, beside it, the live countdown — the
				only sanctioned urgency device besides the active lote: a real date,
				counted down, rather than an invented scarcity number. Sharing the
				row is what lets the deadline argue for the button instead of
				sitting further down the fold as its own block.

				The wrapper carries no `data-enter`: nesting one cascade item inside
				another would compose two `translateY` animations on the same
				subtree.
			*/}
			<div
				class="mt-10 flex flex-col items-start gap-6 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-8 sm:gap-y-6"
			>
				<div
					class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4"
					data-enter="5"
				>
					{hasCheckout && hero.cta.checkoutUrl ? (
						<>
							<a
								href={hero.cta.checkoutUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="group inline-flex min-h-[52px] items-center justify-center gap-3 rounded-full bg-gold px-7 font-semibold text-ink-deep shadow-(--shadow-halo-gold) transition-transform duration-300 hover:scale-[1.03] focus-visible:scale-[1.03]"
							>
								<span>{hero.cta.checkoutLabel ?? "Garantir vaga"}</span>
								<Icon
									name="arrow-right"
									size={18}
									strokeWidth={2.25}
									class="transition-transform duration-300 group-hover:translate-x-1"
								/>
							</a>
							<button
								type="button"
								data-lead-cta="hero"
								data-whatsapp-url={ctaHref}
								class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--color-gold)_40%,transparent)] px-6 text-sm font-medium text-text-primary transition-colors hover:border-gold hover:text-gold"
								aria-label={`${hero.cta.label} — atendimento consultivo`}
							>
								<Icon name="message-circle" size={18} strokeWidth={2.25} />
								<span>{hero.cta.label}</span>
							</button>
						</>
					) : (
						<button
							type="button"
							data-lead-cta="hero"
							data-whatsapp-url={ctaHref}
							class="group inline-flex min-h-[52px] items-center justify-center gap-3 whitespace-nowrap rounded-full bg-gold px-7 font-semibold text-ink-deep shadow-(--shadow-halo-gold) transition-transform duration-300 hover:scale-[1.03] focus-visible:scale-[1.03] active:scale-[0.98]"
							aria-label={hero.cta.label}
						>
							<Icon name="message-circle" size={20} strokeWidth={2.25} />
							<span>{hero.cta.label}</span>
							<Icon
								name="arrow-right"
								size={18}
								strokeWidth={2.25}
								class="hidden transition-transform duration-300 group-hover:translate-x-1 sm:block"
							/>
						</button>
					)}
				</div>

				{/*
					`<dl>` without `aria-live`: announcing a new value every second
					would be noise. The list carries a label and is read on demand.
				*/}
				{countdown && (
					<div
						class="w-full border-t border-[color-mix(in_srgb,var(--color-gold)_16%,transparent)] pt-5 sm:w-auto sm:border-t-0 sm:border-l sm:pt-0 sm:pl-8"
						data-cd-target={countdown.target}
						data-cd-wrap
					>
						<p
							class="flex items-center gap-3 text-kicker font-semibold uppercase tracking-kicker text-text-secondary"
						>
							{countdown.heroKicker}
						</p>

						{/*
							`flex-nowrap` + a `ch`-sized number cell + non-wrapping labels:
							the row must be geometry-stable, because it sits inside a hero
							whose height is content-driven. A single wrap when the body face
							swaps in moves the full-bleed plate behind it by ~50px — which is
							the whole CLS budget for the page.

			The fold shows only days, hours and minutes: a long-cycle decision
			does not need a live seconds display beside the CTA.
						*/}
						<dl
							class="hero-countdown mt-3 grid grid-cols-3 gap-4 sm:flex sm:flex-nowrap sm:items-end sm:gap-3.5"
							aria-label={countdown.ariaLabel}
						>
							{[
								{ key: "d", rotulo: countdown.unidades.dias, valor: "000", cells: "3.4ch" },
								{ key: "h", rotulo: countdown.unidades.horas, valor: "00", cells: "2.3ch" },
								{ key: "m", rotulo: countdown.unidades.minutos, valor: "00", cells: "2.3ch" },
							].map((unidade) => (
								<div
									class="cd-unit flex flex-col-reverse items-start"
								>
									<dt
										class="mt-1 whitespace-nowrap text-kicker font-semibold uppercase tracking-[0.2em] text-text-muted"
									>
										{unidade.rotulo}
									</dt>
									<dd
										class="m-0 font-display text-[clamp(1.5rem,2vw,1.875rem)] font-extrabold leading-none tabular-nums text-text-primary"
										style={`min-width: ${unidade.cells}`}
										data-cd={unidade.key}
									>
										{unidade.valor}
									</dd>
								</div>
							))}
						</dl>
					</div>
				)}
			</div>
		</div>
	</div>

	{/*
		Fact rail — the objective block the brief asks for: date, place, duration
		and format, sitting on the bottom edge of the fold, spanning the container.
		Hairlines separate the cells; no card, no glass.
	*/}
	{hero.facts && (
		<div
			class="relative z-10 border-t border-[color-mix(in_srgb,var(--color-gold)_22%,transparent)] bg-[color-mix(in_srgb,var(--color-ink-deep)_72%,transparent)] backdrop-blur-sm"
		>
			<dl
				class="mx-auto grid max-w-7xl grid-cols-2 gap-px bg-[color-mix(in_srgb,var(--color-gold)_14%,transparent)] px-6 lg:grid-cols-4 lg:px-8"
			>
				{/* A `dl > div` group may only hold `dt`/`dd` — the icon lives inside
				    the term, not beside the group (axe: definition-list/dlitem). */}
				{hero.facts.map((fact) => (
					<div
						class="min-w-0 bg-[color-mix(in_srgb,var(--color-ink-deep)_92%,transparent)] px-4 py-5 lg:px-6 lg:py-6"
					>
						<dt
							class="flex items-center gap-2.5 text-kicker font-semibold uppercase tracking-kicker text-text-muted"
						>
							<Icon
								name={fact.icone as IconName}
								size={18}
								strokeWidth={1.75}
								class="shrink-0 text-text-secondary"
							/>
							{fact.rotulo}
						</dt>
						<dd class="mt-1.5 text-sm font-medium tabular-nums text-text-primary">
							{fact.valor}
						</dd>
					</div>
				))}
			</dl>
		</div>
	)}
</section>
