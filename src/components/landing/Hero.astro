---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { resolveImage } from "../../lib/images";
import { whatsappUrlWithText } from "../../lib/whatsapp";
import Icon, { type IconName } from "../icons/Icon.astro";

/** Edition spec rail. Derived in `index.astro` from `edicao`,
 *  `programa.horas` and the active lote — never duplicated in the JSON, so it
 *  can never drift from the lote table rendered in Investimento. */
export interface FichaRow {
	rotulo: string;
	valor: string;
	prefixo?: string;
	destaque?: boolean;
}

export interface Props {
	hero: CollectionEntry<"products">["data"]["hero"];
	ficha?: FichaRow[];
	countdown?: CollectionEntry<"products">["data"]["countdown"];
}

const { hero, ficha, countdown } = Astro.props;
const ctaHref = whatsappUrlWithText(hero.cta.whatsappMessage);
const hasCheckout = Boolean(hero.cta.checkoutUrl);
const plate = resolveImage(hero.background.image);
---

<section
	id="topo"
	class="relative isolate flex min-h-[100svh] flex-col overflow-hidden"
	aria-labelledby="hero-heading"
>
	{/*
		Plate: a real <img>, not a CSS background — this is the LCP element and
		needs eager loading, a priority hint and intrinsic dimensions (CLS 0).

		`widths` must span the rendered box across DPRs: this is `sizes="100vw"`,
		so a laptop at 1440 CSS px already needs the 1600 step. Sharp's AVIF
		default is quality 50, which smears faces on a group photograph — hence
		the explicit value. Keep it lower here than on the lazy plates: this file
		is the LCP and pays its bytes on first paint.
	*/}
	{/*
		The parallax wrapper is overscanned by 12% on the block axis so the plate
		still covers the frame at either end of the travel. Its `transform` is
		reserved for the scroll offset — the image inside never transforms, which
		is what keeps the plate from jumping (stability.md § Debug triage).
	*/}
	<div
		class="absolute inset-x-0 -inset-y-[12%] -z-20"
		data-parallax
		data-speed="0.16"
		aria-hidden="true"
	>
		<Picture
			src={plate}
			alt=""
			formats={["avif", "webp"]}
			fallbackFormat="jpeg"
			widths={[640, 960, 1280, 1600]}
			quality={62}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			decoding="sync"
			aria-hidden="true"
			class="h-full w-full object-cover object-[center_32%]"
		/>
	</div>

	{/* Scrim: keeps body copy ≥4.5:1 and headings ≥3:1 over the photograph. */}
	<div
		class="absolute inset-0 -z-10"
		aria-hidden="true"
		style="background: linear-gradient(105deg, color-mix(in srgb, var(--color-navy-deep) 95%, transparent) 0%, color-mix(in srgb, var(--color-navy) 88%, transparent) 52%, color-mix(in srgb, var(--color-navy) 74%, transparent) 100%);"
	>
	</div>

	{/* Two accent washes at different parallax speeds. Gold reads as the light
	    source; the slower crimson pool on the opposite corner is what gives the
	    fold depth as it scrolls — one flat wash reads as a gradient, two moving
	    against each other read as space. */}
	<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
		<div
			class="absolute -top-40 -left-32 h-[560px] w-[560px] rounded-full opacity-[0.12]"
			data-parallax
			data-parallax-slack="70"
			data-speed="0.06"
			style="background: radial-gradient(circle, var(--color-gold) 0%, transparent 70%);"
		>
		</div>
		<div
			class="absolute -bottom-48 -right-40 h-[660px] w-[660px] rounded-full opacity-[0.2]"
			data-parallax
			data-parallax-slack="110"
			data-speed="0.1"
			style="background: radial-gradient(circle, var(--color-crimson-bright) 0%, transparent 66%);"
		>
		</div>
	</div>

	{/* The whole fold fades and drifts as it leaves — the transition into
	    section 01 instead of a hard cut. Written by motion.ts. */}
	<div
		class="mx-auto flex w-full max-w-7xl flex-1 items-center px-6 pt-24 pb-10 lg:px-8 lg:pt-28"
		data-hero-fade
	>
		<div
			class="flex w-full flex-wrap items-end gap-x-[clamp(2rem,5vw,4.5rem)] gap-y-12"
		>
		<div class="min-w-0 flex-[1_1_38rem]">
			{hero.eyebrow && (
				<p
					class="flex items-center gap-3.5 text-kicker font-semibold uppercase tracking-kicker text-gold tabular-nums"
					data-enter="1"
				>
					{/* Crimson rule — the sanctioned date/place marker role, and the
					    first thing that ties the fold to "Estados Unidos". */}
					<span
						class="h-0.5 w-11 shrink-0"
						style="background-color: var(--color-crimson-bright);"
						aria-hidden="true"></span>
					{hero.eyebrow}
				</p>
			)}

			<h1
				id="hero-heading"
				class="mt-6 font-display text-display font-bold text-balance"
				data-enter="2"
			>
				<span class="block text-text-primary">{hero.headline}</span>
				{hero.highlight && (
					<span class="mt-1 block text-shimmer">{hero.highlight}</span>
				)}
			</h1>

			<p
				class="mt-7 max-w-2xl text-lede font-light text-text-secondary"
				data-enter="3"
			>
				{hero.subheadline}
			</p>

			<ul
				class="mt-8 hidden flex-wrap gap-2.5 sm:flex"
				data-enter="4"
				aria-label="Diferenciais do programa"
			>
				{hero.badges.map((badge) => (
					<li
						class="inline-flex items-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--color-gold)_25%,transparent)] bg-navy-soft-70 px-3.5 py-1.5 text-meta font-medium text-text-primary/90"
					>
						<span class="h-1.5 w-1.5 rounded-full bg-gold" aria-hidden="true"></span>
						{badge}
					</li>
				))}
			</ul>

			{/* CTA duo. Gold stays on the single primary action; the checkout link
			    takes the gold slot only once otb.json carries the official URL. */}
			<div
				class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4"
				data-enter="5"
			>
				{hasCheckout && hero.cta.checkoutUrl ? (
					<>
						<a
							href={hero.cta.checkoutUrl}
							target="_blank"
							rel="noopener noreferrer"
							data-shine
							class="group inline-flex min-h-[52px] items-center justify-center gap-3 rounded-full bg-gold px-7 font-semibold text-navy shadow-(--shadow-halo-gold) transition-transform duration-300 hover:scale-[1.03] focus-visible:scale-[1.03]"
						>
							<span>{hero.cta.secondaryLabel ?? "Garantir vaga"}</span>
							<Icon
								name="arrow-right"
								size={18}
								strokeWidth={2.25}
								class="transition-transform duration-300 group-hover:translate-x-1"
							/>
						</a>
						<button
							type="button"
							data-lead-cta="hero"
							data-whatsapp-url={ctaHref}
							class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--color-gold)_40%,transparent)] px-6 text-sm font-medium text-text-primary transition-colors hover:border-gold hover:text-gold"
							aria-label={`${hero.cta.label} — atendimento consultivo`}
						>
							<Icon name="message-circle" size={18} strokeWidth={2.25} />
							<span>{hero.cta.label}</span>
						</button>
					</>
				) : (
					<>
						<button
							type="button"
							data-lead-cta="hero"
							data-whatsapp-url={ctaHref}
							data-shine
							class="group inline-flex min-h-[52px] items-center justify-center gap-3 rounded-full bg-gold px-7 font-semibold text-navy shadow-(--shadow-halo-gold) transition-transform duration-300 hover:scale-[1.03] focus-visible:scale-[1.03]"
							aria-label={hero.cta.label}
						>
							<Icon name="message-circle" size={20} strokeWidth={2.25} />
							<span>{hero.cta.label}</span>
							<Icon
								name="arrow-right"
								size={18}
								strokeWidth={2.25}
								class="transition-transform duration-300 group-hover:translate-x-1"
							/>
						</button>
						<a
							href="#programa"
							class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--color-gold)_30%,transparent)] px-6 text-sm font-medium text-text-primary/90 transition-colors hover:border-gold hover:text-gold"
						>
							Conhecer o programa
						</a>
					</>
				)}
			</div>

			{/*
				Live countdown. The only sanctioned urgency device besides the active
				lote: a real date, counted down, rather than an invented scarcity
				number. Runs under reduced motion too — it is information.

				`<dl>` without `aria-live`: announcing a new value every second would
				be noise. The list carries a label and is read on demand.
			*/}
			{countdown && (
				<div
					class="mt-block border-t border-[color-mix(in_srgb,var(--color-gold)_16%,transparent)] pt-[26px]"
					data-enter="6"
					data-cd-target={countdown.target}
					data-cd-wrap
				>
					<p
						class="flex items-center gap-3 text-kicker font-semibold uppercase tracking-kicker text-gold-light"
					>
						<span
							class="live-dot relative inline-flex h-2 w-2 shrink-0 rounded-full"
							style="background-color: var(--color-crimson-bright);"
							aria-hidden="true"></span>
						{countdown.heroKicker}
					</p>

					{/*
						`flex-nowrap` + a `ch`-sized number cell + non-wrapping labels:
						the row must be geometry-stable, because it sits inside a hero
						whose height is content-driven. A single wrap when the body face
						swaps in moves the full-bleed plate behind it by ~50px — which is
						the whole CLS budget for the page.

						Seconds are desktop-only: a digit ticking next to the CTAs is
						noise on a phone, and dropping it buys the row its margin.
					*/}
					<dl
						class="mt-4 flex flex-nowrap items-end gap-2.5 sm:gap-4"
						aria-label={countdown.ariaLabel}
					>
						{[
							{ key: "d", rotulo: countdown.unidades.dias, valor: "000", cells: "3.4ch" },
							{ key: "h", rotulo: countdown.unidades.horas, valor: "00", cells: "2.3ch" },
							{ key: "m", rotulo: countdown.unidades.minutos, valor: "00", cells: "2.3ch" },
							{
								key: "s",
								rotulo: countdown.unidades.segundos,
								valor: "00",
								cells: "2.3ch",
								apenasDesktop: true,
							},
						].map((unidade) => (
							<div
								class={`cd-unit flex-col-reverse items-start ${unidade.apenasDesktop ? "hidden sm:flex" : "flex"}`}
							>
								<dt
									class="mt-1.5 whitespace-nowrap text-kicker font-semibold uppercase tracking-[0.2em] text-text-muted"
								>
									{unidade.rotulo}
								</dt>
								<dd
									class="m-0 font-display text-[clamp(1.625rem,2.4vw,2.125rem)] font-extrabold leading-none tabular-nums text-text-primary"
									style={`min-width: ${unidade.cells}`}
									data-cd={unidade.key}
								>
									{unidade.valor}
								</dd>
							</div>
						))}
					</dl>
				</div>
			)}
		</div>

		{/*
			Edition spec rail. The asymmetric second column the fold was missing:
			it used to be a single 4xl text block with dead space to its right at
			≥1280px. Hairlines and numerals only — the glass pedestal stays
			reserved for Investimento (DESIGN.md § Depth).
		*/}
		{ficha && ficha.length > 0 && (
			<aside
				class="w-full min-w-0 flex-[0_1_20rem] border-t border-[color-mix(in_srgb,var(--color-gold)_22%,transparent)] pt-6 lg:w-auto lg:border-t-0 lg:border-l lg:pt-0 lg:pl-[clamp(1.25rem,2vw,2rem)]"
				aria-labelledby="hero-ficha-label"
				data-enter="7"
			>
				<p
					id="hero-ficha-label"
					class="text-kicker font-semibold uppercase tracking-kicker text-text-muted"
				>
					Ficha da edição
				</p>
				<dl
					class="mt-5 divide-y divide-[color-mix(in_srgb,var(--color-gold)_14%,transparent)]"
				>
					{ficha.map((row) => (
						<div class="grid gap-1.5 py-4 first:pt-0 last:pb-0">
							<dt
								class="text-kicker font-semibold uppercase tracking-kicker text-text-muted"
							>
								{row.rotulo}
							</dt>
							<dd class="m-0 flex items-baseline gap-2 tabular-nums">
								{row.prefixo && (
									<span class="text-sm font-medium text-text-secondary">
										{row.prefixo}
									</span>
								)}
								<span
									class={
										row.destaque
											? "font-display text-3xl font-extrabold tracking-tight text-gradient-gold"
											: "font-display text-xl font-bold tracking-tight text-text-primary"
									}
								>
									{row.valor}
								</span>
							</dd>
						</div>
					))}
				</dl>
			</aside>
		)}
		</div>
	</div>

	{/*
		Fact rail — the objective block the brief asks for: date, place, duration
		and format, sitting on the bottom edge of the fold, spanning the container.
		Hairlines separate the cells; no card, no glass.
	*/}
	{hero.facts && (
		<div
			class="relative z-10 border-t border-[color-mix(in_srgb,var(--color-gold)_22%,transparent)] bg-[color-mix(in_srgb,var(--color-navy-deep)_72%,transparent)] backdrop-blur-sm"
			data-enter="8"
		>
			<dl
				class="mx-auto grid max-w-7xl grid-cols-2 gap-px bg-[color-mix(in_srgb,var(--color-gold)_14%,transparent)] px-6 lg:grid-cols-4 lg:px-8"
			>
				{/* A `dl > div` group may only hold `dt`/`dd` — the icon lives inside
				    the term, not beside the group (axe: definition-list/dlitem). */}
				{hero.facts.map((fact) => (
					<div
						class="min-w-0 bg-[color-mix(in_srgb,var(--color-navy-deep)_92%,transparent)] px-4 py-5 lg:px-6 lg:py-6"
					>
						<dt
							class="flex items-center gap-2.5 text-kicker font-semibold uppercase tracking-kicker text-text-muted"
						>
							<Icon
								name={fact.icone as IconName}
								size={18}
								strokeWidth={1.75}
								class="shrink-0 text-gold"
							/>
							{fact.rotulo}
						</dt>
						<dd class="mt-1.5 text-sm font-medium tabular-nums text-text-primary">
							{fact.valor}
						</dd>
					</div>
				))}
			</dl>
		</div>
	)}
</section>
