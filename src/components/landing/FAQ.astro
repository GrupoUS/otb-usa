---
import type { CollectionEntry } from "astro:content";
import Icon from "../icons/Icon.astro";
import SectionHeader from "./SectionHeader.astro";

type ProductData = CollectionEntry<"products">["data"];

export interface Props {
	faq: ProductData["faq"];
	faqIntro?: ProductData["faqIntro"];
}

const { faq, faqIntro } = Astro.props;

const faqJsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faq.map((item) => ({
		"@type": "Question",
		name: item.pergunta,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.resposta,
		},
	})),
};
---

{/*
	Box removed: full-width rows on hairlines. Questions are set in Inter, not
	Playfair — serif questions were competing with the section headings and
	flattening the page's hierarchy. Rows are ≥56px for touch.
*/}
<section
	id="faq"
	class="band-base relative py-section-tight"
	aria-labelledby="faq-heading"
>
	<div class="mx-auto max-w-4xl px-6 lg:px-8">
		{faqIntro && (
			<SectionHeader
				headingId="faq-heading"
				numeral="11"
				kicker={faqIntro.kicker}
				headline={faqIntro.headline}
			/>
		)}

		<div
			class="mt-block divide-y divide-[color-mix(in_srgb,var(--color-gold)_16%,transparent)] border-y border-[color-mix(in_srgb,var(--color-gold)_16%,transparent)]"
		>
			{faq.map((item, idx) => (
				<details
					class="faq-item group"
					data-reveal="up"
					data-reveal-delay={String(Math.min(idx + 1, 10))}
				>
					<summary
						class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 text-left text-body font-medium text-text-primary transition-colors hover:text-gold group-open:text-gold"
					>
						<span class="min-w-0 wrap-break-word">{item.pergunta}</span>
						<span
							class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-gold-mid-35 text-gold transition-all duration-300 group-open:rotate-180 group-open:border-gold group-open:bg-gold-tint-10"
							aria-hidden="true"
						>
							<Icon name="chevron-down" size={18} strokeWidth={2.25} />
						</span>
					</summary>
					<div
						class="faq-answer max-w-prose wrap-break-word pb-6 text-body text-text-secondary"
					>
						{item.resposta}
					</div>
				</details>
			))}
		</div>
	</div>

	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)}></script>
</section>

<style>
	/* Native <details> disclosure; only the chevron (transform) and the answer
	   panel (opacity + translateY) animate. */
	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary {
		list-style: none;
	}

	@keyframes faq-answer-in {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.faq-item[open] > .faq-answer {
		animation: faq-answer-in 280ms var(--ease-editorial) both;
		will-change: transform, opacity;
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-item[open] > .faq-answer {
			animation: none;
			will-change: auto;
		}
	}
</style>
