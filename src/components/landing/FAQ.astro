---
import type { CollectionEntry } from "astro:content";
import Icon from "../icons/Icon.astro";

export interface Props {
	faq: CollectionEntry<"products">["data"]["faq"];
}

const { faq } = Astro.props;

const faqJsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faq.map((item) => ({
		"@type": "Question",
		name: item.pergunta,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.resposta,
		},
	})),
};
---

<section id="faq" class="relative py-24 sm:py-28" aria-labelledby="faq-heading">
	<div class="mx-auto max-w-4xl px-6 lg:px-8">
		<div class="text-center" data-reveal="up">
			<span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.32em] text-gold">
				<span class="h-px w-10 bg-gold/60"></span>
				Perguntas frequentes
			</span>
			<h2
				id="faq-heading"
				class="mt-5 font-serif text-3xl font-bold leading-[1.1] tracking-tight text-balance text-text-primary sm:text-4xl md:text-5xl"
			>
				Dúvidas comuns sobre o OTB
			</h2>
		</div>

		<div class="mt-14 divide-y divide-[color-mix(in_srgb,var(--color-gold)_18%,transparent)] overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--color-gold)_20%,transparent)] bg-[color-mix(in_srgb,var(--color-navy-light)_60%,transparent)]">
			{faq.map((item, idx) => (
				<details
					class="faq-item group"
					data-reveal="up"
					data-reveal-delay={String(Math.min(idx + 1, 6))}
				>
					<summary
						class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-left text-base font-medium text-text-primary transition-colors hover:text-gold sm:px-8 sm:text-lg"
					>
						<span class="min-w-0 break-words font-serif">{item.pergunta}</span>
						<span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[color-mix(in_srgb,var(--color-gold)_35%,transparent)] text-gold transition-transform duration-300 group-open:rotate-180">
							<Icon name="chevron-down" size={18} strokeWidth={2.25} />
						</span>
					</summary>
					<div class="break-words px-6 pb-6 text-sm leading-relaxed text-text-muted sm:px-8 sm:text-base">
						{item.resposta}
					</div>
				</details>
			))}
		</div>
	</div>

	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
</section>

<style>
	/* Cardinal #8: never animate layout properties. <details> open toggle is content-driven;
	   animate only the chevron (transform) + answer panel fade (opacity + translateY).
	   Native <details> handles disclosure; we only soften the appearance of the inner panel. */
	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	@keyframes faq-answer-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.faq-item[open] > div {
		animation: faq-answer-in 240ms cubic-bezier(0.16, 1, 0.3, 1) both;
		will-change: transform, opacity;
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-item[open] > div {
			animation: none;
			will-change: auto;
		}
	}
</style>
