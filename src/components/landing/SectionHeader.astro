---
/**
 * Shared section spine: structural numeral + kicker + rule + heading.
 *
 * Replaces the recipe that was copy-pasted into 8 of 11 sections
 * (`text-[11px] uppercase tracking-[0.32em] text-gold` + a gold hairline).
 *
 * Gold discipline (DESIGN.md § 3): the kicker is muted and only the rule and
 * the numeral carry gold at low weight, so the ONE gold moment per section is
 * the gradient on `highlight`. Never make the kicker gold again.
 */
export interface Props {
	headingId: string;
	kicker: string;
	headline: string;
	numeral?: string;
	highlight?: string;
	descricao?: string;
	accent?: "gold" | "crimson";
	align?: "start" | "center";
	/** `mask` uncovers the block bottom-up instead of translating it. Use it
	 *  where the heading must hold its final position from the first frame. */
	reveal?: "up" | "mask";
	class?: string;
}

const {
	headingId,
	kicker,
	headline,
	numeral,
	highlight,
	descricao,
	accent = "gold",
	align = "start",
	reveal = "up",
	class: className = "",
} = Astro.props;

const ruleTone = accent === "crimson" ? "bg-crimson-bright/70" : "bg-gold/70";
/* The heading gradient is ALWAYS gold. `--color-crimson-bright` as text
   measures ~2.3:1 on navy — below AA even at large sizes — so the crimson
   accent tints the structural rule only. */
const highlightTone = "text-gradient-gold";
const alignment =
	align === "center" ? "mx-auto max-w-3xl text-center" : "max-w-3xl";
const rowAlignment = align === "center" ? "justify-center" : "";
---

<div class={`${alignment} ${className}`} data-reveal={reveal}>
	<div class={`flex items-center gap-4 ${rowAlignment}`}>
		{/*
			Crimson plate. This is the page's numbering system: a solid, squared
			chip rather than the previous ghost-gold numeral, which disappeared
			against the band at anything below a 1440px viewport. Text-primary on
			--color-crimson measures 7.3:1, so the plate is legible even though it
			is decorative (aria-hidden — the heading already carries the meaning).
		*/}
		{numeral && (
			<span
				class="inline-flex h-[42px] min-w-[42px] shrink-0 items-center justify-center rounded-plate px-2.5 font-display text-sm font-bold leading-none tracking-[0.06em] tabular-nums text-text-primary"
				style="background-color: var(--color-crimson);"
				aria-hidden="true"
			>
				{numeral}
			</span>
		)}
		<span
			class="inline-flex items-center gap-3 text-kicker font-semibold uppercase tracking-kicker text-text-muted"
		>
			<span class={`h-px w-8 ${ruleTone}`} aria-hidden="true"></span>
			{kicker}
		</span>
	</div>

	<h2
		id={headingId}
		class="mt-6 font-display text-h2 font-extrabold text-balance text-text-primary"
	>
		{headline}
		{highlight && (
			<span class={`mt-2 block ${highlightTone}`}>{highlight}</span>
		)}
	</h2>

	{descricao && (
		<p class="mt-5 text-lede font-light text-text-secondary">{descricao}</p>
	)}
</div>
