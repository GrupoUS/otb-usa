---
import type { CollectionEntry } from "astro:content";
import Icon, { type IconName } from "../icons/Icon.astro";
import SectionHeader from "./SectionHeader.astro";

export interface Props {
	audience: CollectionEntry<"products">["data"]["audience"];
}

const { audience } = Astro.props;
---

{/*
	The quiet typographic section, on the alternate band.

	The background photograph was removed on purpose: it repeated the hero
	treatment two screens later and diluted the gallery, which is the page's
	only real proof asset. Professions became an inline pill row instead of six
	glass cards — they are a qualifier, not six features.
*/}
<section
	id="publico"
	class="band-alt relative py-section"
	aria-labelledby="audience-heading"
>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-20">
			<div class="lg:col-span-5" data-reveal="left">
				<SectionHeader
					headingId="audience-heading"
					numeral="02"
					kicker="Para quem é"
					headline={audience.headline}
				/>

				<blockquote
					class="mt-8 border-l-2 border-gold/60 pl-5 font-display text-h3 leading-snug text-text-primary italic"
				>
					{audience.quote}
				</blockquote>

				<p class="mt-6 text-meta text-text-muted">{audience.legenda}</p>
			</div>

			<div class="lg:col-span-7">
				<ul class="flex flex-wrap gap-2.5" aria-label="Profissões elegíveis">
					{audience.categorias.map((c, idx) => (
						<li
							class="inline-flex min-h-11 items-center gap-2.5 rounded-full border border-[color-mix(in_srgb,var(--color-gold)_22%,transparent)] px-4 text-sm font-medium text-text-primary transition-colors duration-200 hover:border-[color-mix(in_srgb,var(--color-gold)_50%,transparent)]"
							data-reveal="up"
							data-reveal-delay={String((idx % 6) + 1)}
						>
							<Icon
								name={c.icone as IconName}
								size={16}
								strokeWidth={1.75}
								class="text-gold"
								aria-hidden="true"
							/>
							{c.nome}
						</li>
					))}
				</ul>

				{audience.personaBullets && audience.personaBullets.length > 0 && (
					<div class="mt-block" data-reveal="up" data-reveal-delay="2">
						{audience.personaIntro && (
							<p
								class="max-w-2xl font-display text-h3 leading-snug text-text-primary"
							>
								{audience.personaIntro}
							</p>
						)}

						{/* Numbered ledger: hairline rows, gold numerals, no boxes. */}
						<ol
							class="mt-8 divide-y divide-[color-mix(in_srgb,var(--color-gold)_16%,transparent)] border-t border-[color-mix(in_srgb,var(--color-gold)_16%,transparent)]"
						>
							{audience.personaBullets.map((bullet, idx) => (
								<li
									class="flex min-w-0 items-baseline gap-5 py-4"
									data-reveal="up"
									data-reveal-delay={String((idx % 4) + 3)}
								>
									<span
										class="shrink-0 font-sans text-xl font-bold leading-none tabular-nums text-gold/70"
										aria-hidden="true"
									>
										{String(idx + 1).padStart(2, "0")}
									</span>
									<span class="min-w-0 wrap-break-word text-body text-text-secondary">
										{bullet}
									</span>
								</li>
							))}
						</ol>
					</div>
				)}
			</div>
		</div>
	</div>
</section>
