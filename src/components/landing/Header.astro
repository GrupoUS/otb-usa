---
import type { CollectionEntry } from "astro:content";

type ProductData = CollectionEntry<"products">["data"];

export interface Props {
	header: NonNullable<ProductData["header"]>;
	whatsappMessage: string;
}

const { header } = Astro.props;
---

{/*
	Fixed shell. Transparent over the hero; goes solid past 40px of scroll — the
	state is written by the single scroll listener in src/scripts/motion.ts, so
	this component is markup only. No hamburger on mobile by design: the slot is
	spent on the edition chip (date + place), which is the fold's job per the
	brief.
*/}
<header
	id="site-header"
	class="site-header fixed inset-x-0 top-0 z-40"
	data-header
>
	<div
		class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-6 lg:h-[68px] lg:px-8"
	>
		<a
			href="#topo"
			class="inline-flex shrink-0 items-center"
			aria-label={`${header.marca} — voltar ao topo`}
		>
			{/* Rendered 36-44px tall, so the box is ~80px wide: the 360px plate was
			    4.5x oversize. Served as quantised PNG-8 at 1x/2x (2.1KB / 5.6KB)
			    instead of through astro:assets — measured on this file, webp and
			    avif both come out LARGER than PNG-8 for flat wordmark art. See
			    src/assets/images/otb/README.md. */}
			<img
				src="/images/otb/otb-logo-gold-176.png"
				srcset="/images/otb/otb-logo-gold-176.png 1x, /images/otb/otb-logo-gold-352.png 2x"
				alt=""
				width="176"
				height="97"
				decoding="async"
				class="h-9 w-auto object-contain lg:h-11"
				aria-hidden="true"
			/>
		</a>

		<nav class="hidden lg:block" aria-label="Navegação principal">
			<ul class="flex items-center gap-8 text-sm text-text-secondary">
				{header.nav.map((item) => (
					<li>
						<a
							class="inline-flex min-h-11 items-center transition-colors duration-200 hover:text-gold focus-visible:text-gold"
							href={item.href}
						>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		{/* Edition chip — crimson is allowed here: it is the date/place marker. */}
		<span
			class="inline-flex shrink-0 items-center gap-2 rounded-full border border-crimson-mid-45 bg-crimson-tint-10 px-3 py-1.5 text-kicker font-semibold tracking-kicker text-text-primary tabular-nums lg:hidden"
		>
			<span
				class="h-1.5 w-1.5 rounded-full"
				style="background-color: var(--color-crimson-bright);"
				aria-hidden="true"></span>
			{header.edicaoChip}
		</span>

	</div>
</header>
