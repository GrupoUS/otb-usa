---
/**
 * Decorative section divider. Navy → Gold or Navy → Crimson filete.
 * Cardinal #3: no emoji. Cardinal #7: no inline hex (uses CSS tokens).
 *
 * Variants:
 *  - "line"    (default) — full-width hairline fade
 *  - "dot"     — hairline with a centered lozenge
 *  - "numeral" — hairline with a centered serif numeral (pass `numeral`)
 *
 * Tone:
 *  - "gold"    (default) — gold hairline (existing behaviour)
 *  - "crimson" — crimson-bright hairline (Boston · USA accent sections)
 */
export interface Props {
	class?: string;
	variant?: "line" | "dot" | "numeral";
	numeral?: string;
	tone?: "gold" | "crimson";
}

const {
	class: className = "",
	variant = "line",
	numeral,
	tone = "gold",
} = Astro.props;

const viaColor =
	tone === "crimson"
		? "color-mix(in srgb, var(--color-crimson-bright) 55%, transparent)"
		: "color-mix(in srgb, var(--color-gold) 55%, transparent)";

const dotBg = tone === "crimson" ? "bg-crimson-bright" : "bg-gold";
const dotGlow =
	tone === "crimson"
		? "shadow-[0_0_18px_color-mix(in_srgb,var(--color-crimson-bright)_55%,transparent)]"
		: "shadow-[0_0_18px_color-mix(in_srgb,var(--color-gold)_55%,transparent)]";

const numeralColor = tone === "crimson" ? "text-crimson-bright" : "text-gold";
---

<div
	class={`relative mx-auto h-px w-full max-w-7xl ${className}`}
	aria-hidden="true"
>
	<div
		class="absolute inset-0"
		style={`background: linear-gradient(to right, transparent, ${viaColor}, transparent);`}
	>
	</div>

	{variant === "dot" && (
		<span
			class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
		>
			<span
				class={`block h-1.5 w-1.5 rotate-45 ${dotBg} ${dotGlow}`}
			></span>
		</span>
	)}

	{variant === "numeral" && numeral && (
		<span
			class={`absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-navy px-4 font-serif text-xs font-semibold uppercase tracking-[0.32em] ${numeralColor}`}
		>
			{numeral}
		</span>
	)}
</div>
