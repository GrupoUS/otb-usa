---
/**
 * Decorative section divider. Navy → Gold filete.
 * Cardinal #3: no emoji. Cardinal #7: no inline hex (uses CSS tokens).
 *
 * Variants:
 *  - "line"    (default) — full-width gold hairline fade
 *  - "dot"     — hairline with a centered gold lozenge
 *  - "numeral" — hairline with a centered serif numeral (pass `numeral`)
 */
export interface Props {
	class?: string;
	variant?: "line" | "dot" | "numeral";
	numeral?: string;
}

const { class: className = "", variant = "line", numeral } = Astro.props;
---

<div
	class={`relative mx-auto h-px w-full max-w-7xl ${className}`}
	aria-hidden="true"
>
	<div
		class="absolute inset-0 bg-linear-to-r from-transparent via-[color-mix(in_srgb,var(--color-gold)_55%,transparent)] to-transparent"
	>
	</div>

	{variant === "dot" && (
		<span
			class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
		>
			<span
				class="block h-1.5 w-1.5 rotate-45 bg-gold shadow-[0_0_18px_color-mix(in_srgb,var(--color-gold)_55%,transparent)]"
			></span>
		</span>
	)}

	{variant === "numeral" && numeral && (
		<span
			class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-navy px-4 font-serif text-xs font-semibold uppercase tracking-[0.32em] text-gold"
		>
			{numeral}
		</span>
	)}
</div>
