---
import { getImage, Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { resolveImage } from "../../lib/images";
import Icon from "../icons/Icon.astro";
import Lightbox from "./Lightbox.astro";
import SectionHeader from "./SectionHeader.astro";

export interface Props {
	turmas: CollectionEntry<"products">["data"]["turmas"];
}

const { turmas } = Astro.props;

const [lead, ...rest] = turmas.fotos;

/** Enlarged variants for the lightbox. Built at 1600w webp rather than serving
 *  the original: the source plates are multi-megabyte camera JPEGs and the
 *  dialog caps the render at 78vh anyway. */
const zoomSrc = new Map<string, string>(
	await Promise.all(
		turmas.fotos.map(async (foto) => {
			const optimized = await getImage({
				src: resolveImage(foto.src),
				format: "webp",
				width: 1600,
				quality: 72,
			});
			return [foto.src, optimized.src] as [string, string];
		}),
	),
);

/** Crop rotation — portrait / landscape / portrait keeps the mosaic from
 *  collapsing into a uniform tile wall. One entry per tile (6 in a 3-col grid,
 *  so every row is full at both breakpoints). */
const crops = [
	"aspect-[4/5]",
	"aspect-[3/2]",
	"aspect-[4/5]",
	"aspect-[3/2]",
	"aspect-[4/5]",
	"aspect-[3/2]",
];
---

{/*
	The proof wall. There are no testimonials and none may be invented, so the
	archive of the two previous Boston editions carries the credibility — which
	is why it escapes the container and gets the page's largest allocation.

	Plates are rectilinear (--radius-plate). Captions are ALWAYS visible: the
	previous version revealed them on :hover only, i.e. never on touch.
*/}
<section
	id="turmas"
	class="band-deep relative py-section"
	aria-labelledby="turmas-heading"
>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<SectionHeader
			headingId="turmas-heading"
			numeral="05"
			kicker="Histórico"
			headline={turmas.headline}
			descricao={turmas.descricao}
		/>
	</div>

	{lead && (
		<figure class="mt-block" data-reveal="up">
			<div class="group relative aspect-[21/9] overflow-hidden rounded-plate">
				{/*
					Full-bleed: `sizes="100vw"`, so the widths ladder has to reach the
					widest viewport we serve — NOT the tile ladder below. Getting this
					wrong starves the largest photograph on the page.
				*/}
				<Picture
					src={resolveImage(lead.src)}
					alt={lead.alt}
					formats={["avif", "webp"]}
					fallbackFormat="jpeg"
					widths={[640, 1024, 1600]}
					quality={60}
					sizes="100vw"
					loading="lazy"
					decoding="async"
					fetchpriority="low"
					class="h-full w-full object-cover object-center"
				/>
				{/* Rendered `hidden`; the lightbox script unhides it only once the
				    dialog is known to work, so no-JS never gets a dead control. */}
				<button
					type="button"
					hidden
					data-lightbox-trigger
					data-src={zoomSrc.get(lead.src)}
					data-alt={lead.alt}
					class="absolute inset-0 flex cursor-zoom-in items-end justify-end p-4 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-gold"
					aria-label={`Ampliar foto: ${lead.alt}`}
				>
					<span
						class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-gold-mid-35 bg-[color-mix(in_srgb,var(--color-navy-deep)_72%,transparent)] text-gold opacity-0 backdrop-blur-sm transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100"
						aria-hidden="true"
					>
						<Icon name="expand" size={18} strokeWidth={2} />
					</span>
				</button>
			</div>
			<figcaption
				class="mx-auto mt-3 max-w-7xl px-6 text-meta text-text-muted lg:px-8"
			>
				{lead.alt}
			</figcaption>
		</figure>
	)}

	<div
		class="mt-6 grid grid-cols-2 gap-3 px-3 sm:gap-4 sm:px-4 lg:grid-cols-3"
	>
		{rest.map((foto, i) => {
			return (
				<figure data-reveal="up" data-reveal-delay={String(Math.min(i + 1, 8))}>
					<div
						class={`group relative ${crops[i] ?? "aspect-[3/2]"} overflow-hidden rounded-plate`}
					>
						<Picture
							src={resolveImage(foto.src)}
							alt={foto.alt}
							formats={["avif", "webp"]}
							fallbackFormat="jpeg"
							widths={[400, 640, 900, 1280]}
							quality={62}
							sizes="(min-width: 1024px) 33vw, 50vw"
							loading="lazy"
							decoding="async"
							fetchpriority="low"
							class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.04]"
						/>
						<button
							type="button"
							hidden
							data-lightbox-trigger
							data-src={zoomSrc.get(foto.src)}
							data-alt={foto.alt}
							class="absolute inset-0 flex cursor-zoom-in items-end justify-end p-3 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-gold"
							aria-label={`Ampliar foto: ${foto.alt}`}
						>
							<span
								class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gold-mid-35 bg-[color-mix(in_srgb,var(--color-navy-deep)_72%,transparent)] text-gold opacity-0 backdrop-blur-sm transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100"
								aria-hidden="true"
							>
								<Icon name="expand" size={16} strokeWidth={2} />
							</span>
						</button>
					</div>
					<figcaption class="mt-2 text-meta leading-snug text-text-muted">
						{foto.alt}
					</figcaption>
				</figure>
			);
		})}
	</div>

	<Lightbox />
</section>
