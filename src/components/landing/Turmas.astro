---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { resolveImage } from "../../lib/images";
import SectionHeader from "./SectionHeader.astro";

export interface Props {
	turmas: CollectionEntry<"products">["data"]["turmas"];
}

const { turmas } = Astro.props;

const [lead, ...rest] = turmas.fotos;

/** Crop rotation — portrait / landscape / portrait keeps the mosaic from
 *  collapsing into a uniform tile wall. One entry per tile (6 in a 3-col grid,
 *  so every row is full at both breakpoints). */
const crops = [
	"aspect-[4/5]",
	"aspect-[3/2]",
	"aspect-[4/5]",
	"aspect-[3/2]",
	"aspect-[4/5]",
	"aspect-[3/2]",
];
---

{/*
	The proof wall. There are no testimonials and none may be invented, so the
	archive of the two previous Boston editions carries the credibility — which
	is why it escapes the container and gets the page's largest allocation.

	Plates are rectilinear (--radius-plate). Captions are ALWAYS visible: the
	previous version revealed them on :hover only, i.e. never on touch.
*/}
<section
	id="turmas"
	class="band-deep relative py-section"
	aria-labelledby="turmas-heading"
>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<SectionHeader
			headingId="turmas-heading"
			numeral="05"
			kicker="Histórico"
			headline={turmas.headline}
			descricao={turmas.descricao}
		/>
	</div>

	{lead && (
		<figure class="mt-block" data-reveal="up">
			<div class="aspect-[21/9] overflow-hidden rounded-plate">
				{/*
					Full-bleed: `sizes="100vw"`, so the widths ladder has to reach the
					widest viewport we serve — NOT the tile ladder below. Getting this
					wrong starves the largest photograph on the page.
				*/}
				<Picture
					src={resolveImage(lead.src)}
					alt={lead.alt}
					formats={["avif", "webp"]}
					fallbackFormat="jpeg"
					widths={[640, 1024, 1600]}
					quality={60}
					sizes="100vw"
					loading="lazy"
					decoding="async"
					fetchpriority="low"
					class="h-full w-full object-cover object-center"
				/>
			</div>
			<figcaption
				class="mx-auto mt-3 max-w-7xl px-6 text-meta text-text-muted lg:px-8"
			>
				{lead.alt}
			</figcaption>
		</figure>
	)}

	<div
		class="mt-6 grid grid-cols-2 gap-3 px-3 sm:gap-4 sm:px-4 lg:grid-cols-3"
	>
		{rest.map((foto, i) => {
			return (
				<figure data-reveal="up" data-reveal-delay={String(Math.min(i + 1, 8))}>
					<div class={`${crops[i] ?? "aspect-[3/2]"} overflow-hidden rounded-plate`}>
						<Picture
							src={resolveImage(foto.src)}
							alt={foto.alt}
							formats={["avif", "webp"]}
							fallbackFormat="jpeg"
							widths={[400, 640, 900, 1280]}
							quality={62}
							sizes="(min-width: 1024px) 33vw, 50vw"
							loading="lazy"
							decoding="async"
							fetchpriority="low"
							class="h-full w-full object-cover object-center transition-transform duration-700 hover:scale-[1.03]"
						/>
					</div>
					<figcaption class="mt-2 text-meta leading-snug text-text-muted">
						{foto.alt}
					</figcaption>
				</figure>
			);
		})}
	</div>
</section>
