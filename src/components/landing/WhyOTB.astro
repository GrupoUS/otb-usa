---
import type { CollectionEntry } from "astro:content";
import Icon, { type IconName } from "../icons/Icon.astro";

export interface Props {
	why: CollectionEntry<"products">["data"]["why"];
}

const { why } = Astro.props;

/**
 * Card index 0 = Formação técnica (gold — default glass-card)
 * Card index 1 = Branding internacional / Boston (crimson accent)
 * Card index 2 = Networking global (gold — default glass-card)
 *
 * Icons follow same order.
 */
const cardIcons: IconName[] = ["shield-check", "globe", "sparkles"];

/** Returns true when the card should receive the crimson (Boston) accent. */
const isCrimsonCard = (idx: number) => idx === 1;
---

<section id="por-que-otb" class="relative py-28 sm:py-32" aria-labelledby="why-heading">
	<div class="mx-auto max-w-7xl px-6 lg:px-8">

		{/* Section header */}
		<div class="max-w-3xl" data-reveal="up">
			<span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.32em] text-gold">
				<span class="h-px w-10 bg-gold/60"></span>
				Diferenciais
			</span>
			<h2
				id="why-heading"
				class="mt-5 font-serif text-3xl font-bold leading-[1.1] tracking-tight text-balance sm:text-4xl md:text-5xl"
			>
				<span class="text-text-primary">{why.headline}</span>
				{why.highlight && (
					<span class="ml-3 text-gradient-gold">{why.highlight}</span>
				)}
			</h2>

			{why.positioningQuote && (
				<figure
					class="mt-10 max-w-3xl"
					data-reveal="up"
					data-reveal-delay="1"
				>
					<span
						aria-hidden="true"
						class="block font-serif text-6xl leading-none text-gradient-gold sm:text-7xl"
					>
						&ldquo;
					</span>
					<blockquote
						class="-mt-4 border-l-2 border-gold/45 pl-6 font-serif text-xl leading-[1.35] tracking-tight text-text-primary sm:text-2xl md:text-[1.75rem]"
					>
						{why.positioningQuote}
					</blockquote>
				</figure>
			)}
		</div>

		{/* 3-card grid — card[1] = Boston crimson accent */}
		<div class="mt-16 grid grid-cols-1 gap-6 md:mt-20 md:grid-cols-3 md:gap-7">
			{why.cards.map((card, idx) => (
				<article
					class={[
						"relative flex flex-col gap-5 rounded-2xl p-7 card-hover-lift",
						isCrimsonCard(idx)
							? "glass-card-crimson card-glow-hover-crimson glow-crimson"
							: "glass-card card-glow-hover",
					].join(" ")}
					data-reveal="up"
					data-reveal-delay={String(idx + 2)}
					data-glow-card
				>
					{/* Icon badge */}
					<div
						class={[
							"inline-flex h-12 w-12 items-center justify-center rounded-xl",
							isCrimsonCard(idx)
								? "border border-crimson-mid-35 bg-crimson-tint-10 text-crimson-bright"
								: "border border-gold-mid-35 bg-gold-tint-10 text-gold",
						].join(" ")}
					>
						<Icon name={cardIcons[idx] ?? "sparkles"} size={22} strokeWidth={1.75} />
					</div>

					{/* Card title */}
					<h3 class="font-serif text-xl font-semibold leading-tight text-text-primary">
						{card.titulo}
					</h3>

					{/* Description — body text, always text-muted (never crimson on body) */}
					<p class="text-sm leading-relaxed text-text-muted">{card.descricao}</p>

					{/* Bottom accent filete — crimson card gets crimson filete, others gold */}
					{isCrimsonCard(idx) && (
						<div
							class="mt-auto flex items-center gap-0 overflow-hidden rounded-full pt-2"
							aria-hidden="true"
						>
							<span class="h-[2px] w-8 rounded-l-full bg-crimson-bright/50"></span>
							<span class="h-[2px] flex-1 bg-crimson-mid-35"></span>
							<span class="h-[2px] w-8 rounded-r-full bg-gold/40"></span>
						</div>
					)}
				</article>
			))}
		</div>
	</div>

	{/* Pointer-glow JS: sets --mouse-x/y on [data-glow-card] for both gold and crimson variants */}
	<script is:inline>
		(() => {
			try {
				const cards = document.querySelectorAll("[data-glow-card]");
				if (!cards.length) return;
				// Respect motion preferences — pointer-glow is decorative.
				const reduceMotion =
					typeof window.matchMedia === "function" &&
					window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				if (reduceMotion) return;
				cards.forEach((card) => {
					if (!(card instanceof HTMLElement)) return;
					card.addEventListener("pointermove", (e) => {
						const rect = card.getBoundingClientRect();
						card.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
						card.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
					});
				});
			} catch {
				/* decorative; failure is acceptable */
			}
		})();
	</script>
</section>
