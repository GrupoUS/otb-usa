---
import type { CollectionEntry } from "astro:content";
import Icon, { type IconName } from "../icons/Icon.astro";
import SectionHeader from "./SectionHeader.astro";

export interface Props {
	why: CollectionEntry<"products">["data"]["why"];
}

const { why } = Astro.props;

const cardIcons: IconName[] = ["shield-check", "globe", "sparkles"];
const cardLayouts = [
	"lg:col-span-5 lg:pr-10",
	"lg:col-span-3 lg:border-l lg:border-[color-mix(in_srgb,var(--color-gold)_20%,transparent)] lg:pl-8",
	"lg:col-span-4 lg:border-l lg:border-[color-mix(in_srgb,var(--color-gold)_20%,transparent)] lg:pl-8",
] as const;
---

{/*
	Asymmetric typographic pillars. No card chrome: three columns divided by
	delicate rules. The previous version was
	three glass cards — the exact shape Programa, Boston and Parceiros were
	also using, which is why nothing on the page read as distinct.
*/}
<section
	id="por-que-otb"
	class="band-base relative py-section"
	aria-labelledby="why-heading"
>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<SectionHeader
			headingId="why-heading"
			numeral="02"
			kicker="Diferenciais"
			headline={why.headline}
			highlight={why.highlight}
		/>

		{why.positioningQuote && (
			<figure class="mt-block max-w-4xl" data-reveal="up" data-reveal-delay="1">
				<blockquote
					class="border-l-2 border-gold/45 pl-6 font-display text-h3 leading-snug text-text-primary sm:pl-8"
				>
					{why.positioningQuote}
				</blockquote>
			</figure>
		)}

		{/* The pillars stay static so the section reads as one typographic block. */}
		<div
			class="mt-block grid grid-cols-1 gap-10 md:grid-cols-3 lg:grid-cols-12 md:gap-x-8"
		>
			{why.cards.map((card, idx) => (
				<article
					class:list={["min-w-0", cardLayouts[idx]]}
				>
					<div class="flex items-baseline gap-4">
						<Icon
							name={cardIcons[idx] ?? "sparkles"}
							size={20}
							strokeWidth={1.75}
							class="text-text-secondary"
							aria-hidden="true"
						/>
					</div>
					<h3
						class="mt-5 font-display text-h3 font-semibold leading-tight text-text-primary"
					>
						{card.titulo}
					</h3>
					<p class="mt-3 text-body text-text-secondary">{card.descricao}</p>
				</article>
			))}
		</div>
	</div>
</section>
