---
import type { CollectionEntry } from "astro:content";
import Icon, { type IconName } from "../icons/Icon.astro";
import SectionHeader from "./SectionHeader.astro";

export interface Props {
	why: CollectionEntry<"products">["data"]["why"];
}

const { why } = Astro.props;

const cardIcons: IconName[] = ["shield-check", "globe", "sparkles"];
---

{/*
	Hairline triptych. No card chrome: three columns divided by vertical gold
	rules, each opened by an oversized serif numeral. The previous version was
	three glass cards — the exact shape Programa, Boston and Parceiros were
	also using, which is why nothing on the page read as distinct.
*/}
<section
	id="por-que-otb"
	class="band-base relative py-section"
	aria-labelledby="why-heading"
>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<SectionHeader
			headingId="why-heading"
			numeral="02"
			kicker="Diferenciais"
			headline={why.headline}
			highlight={why.highlight}
		/>

		{why.positioningQuote && (
			<figure class="mt-block max-w-4xl" data-reveal="up" data-reveal-delay="1">
				<blockquote
					class="border-l-2 border-gold/45 pl-6 font-display text-h3 leading-snug text-text-primary sm:pl-8"
				>
					{why.positioningQuote}
				</blockquote>
			</figure>
		)}

		{/* `data-tilt` is the whole hover treatment on these columns — no
		    hover-lift on top of it, because two rules writing the same
		    `transform` cancel each other (stability.md § Debug triage). */}
		<div
			class="mt-block grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-0 md:divide-x md:divide-[color-mix(in_srgb,var(--color-gold)_20%,transparent)]"
		>
			{why.cards.map((card, idx) => (
				<article
					class="md:px-8 md:first:pl-0 md:last:pr-0"
					data-reveal="up"
					data-reveal-delay={String(idx + 2)}
					data-tilt
				>
					<div class="flex items-baseline gap-4">
						<span
							class="font-display text-5xl font-extrabold leading-none tabular-nums text-gold/35"
							aria-hidden="true"
						>
							{String(idx + 1).padStart(2, "0")}
						</span>
						<Icon
							name={cardIcons[idx] ?? "sparkles"}
							size={20}
							strokeWidth={1.75}
							class="text-gold"
							aria-hidden="true"
						/>
					</div>
					<h3
						class="mt-5 font-display text-h3 font-semibold leading-tight text-text-primary"
					>
						{card.titulo}
					</h3>
					<p class="mt-3 text-body text-text-secondary">{card.descricao}</p>
				</article>
			))}
		</div>
	</div>
</section>
