---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { resolveImage } from "../../lib/images";
import { whatsappUrlWithText } from "../../lib/whatsapp";
import Icon from "../icons/Icon.astro";
import SectionHeader from "./SectionHeader.astro";

type ProductData = CollectionEntry<"products">["data"];

export interface Props {
	boston: ProductData["boston"];
	agenda?: ProductData["agenda"];
}

const { boston, agenda } = Astro.props;

const ctaCardHref = boston.ctaCard
	? whatsappUrlWithText(boston.ctaCard.cta.whatsappMessage)
	: null;

/** Splits a stat like "≤ 48h" into the parts around its first integer so the
 *  number can count up while the qualifier ("≤", "h", "%") stays put. Returns
 *  null for non-numeric stats such as "ASA", which simply do not animate. */
function splitStat(valor: string) {
	const match = valor.match(/\d+/);
	if (!match || match.index === undefined) return null;
	return {
		prefix: valor.slice(0, match.index),
		numero: Number(match[0]),
		suffix: valor.slice(match.index + match[0].length),
	};
}
---

{/*
	Boston. Crimson lives here — this is one of its three sanctioned roles
	(date/place marker, timeline spine, active-lote badge).

	The previous version stacked three consecutive grids (cards, stats, agenda).
	Now: a photographic plate with the dates set over it, one timeline rail, and
	a stat band. The three differentiators are a compact text row, not cards.
*/}
<section
	id="boston"
	class="band-alt relative py-section"
	aria-labelledby="boston-heading"
>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<SectionHeader
			headingId="boston-heading"
			numeral="07"
			kicker="Imersão internacional"
			headline={boston.headline}
			highlight={boston.highlight}
			descricao={boston.descricao}
			accent="crimson"
		/>

		<div
			class="mt-block grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-3 lg:grid-cols-12"
			data-reveal="up"
			data-reveal-delay="1"
		>
			{boston.cards.map((card, idx) => (
				<div class:list={["min-w-0", idx === 0 && "lg:col-span-5 lg:pr-8", idx === 1 && "lg:col-span-3 lg:border-l lg:border-[color-mix(in_srgb,var(--color-crimson)_45%,transparent)] lg:pl-6", idx === 2 && "lg:col-span-4 lg:border-l lg:border-[color-mix(in_srgb,var(--color-crimson)_45%,transparent)] lg:pl-6"]}>
					<h3
						class="text-kicker font-semibold uppercase tracking-kicker text-text-muted"
					>
						{card.titulo}
					</h3>
					<p class="mt-3 text-body text-text-secondary">{card.descricao}</p>
				</div>
			))}
		</div>
	</div>

	{/* Plate: the dates set typographically over the photograph. */}
	<figure class="relative mt-block" data-reveal="wipe" data-reveal-delay="2">
		<div class="relative aspect-[16/9] overflow-hidden rounded-plate sm:aspect-[21/9]">
			{/* Overscanned wrapper owns the parallax transform; the image itself
			    never transforms, so the plate cannot jump at the travel limits. */}
			<div
				class="absolute inset-x-0 -inset-y-[10%]"
				data-parallax
				data-speed="0.12"
				aria-hidden="true"
			>
				<Picture
					src={resolveImage(boston.background.image)}
					alt=""
					formats={["avif", "webp"]}
					fallbackFormat="jpeg"
					widths={[640, 1024, 1600]}
					quality={56}
					sizes="100vw"
					loading="lazy"
					decoding="async"
					fetchpriority="low"
					aria-hidden="true"
					class="h-full w-full object-cover object-center"
				/>
			</div>
			<div
				class="absolute inset-0"
				aria-hidden="true"
				style="background: linear-gradient(90deg, transparent 58%, color-mix(in srgb, var(--color-crimson-dark) 34%, transparent) 100%), linear-gradient(90deg, color-mix(in srgb, var(--color-ink-deep) 94%, transparent) 0%, color-mix(in srgb, var(--color-ink-deep) 60%, transparent) 52%, color-mix(in srgb, var(--color-ink-deep) 32%, transparent) 100%);"
			>
			</div>

			{boston.plate && (
				<div
					class="absolute inset-0 mx-auto flex max-w-7xl flex-col justify-center px-6 lg:px-8"
				>
					<span
						class="font-sans text-6xl font-bold leading-none tracking-tight tabular-nums text-text-primary sm:text-7xl lg:text-8xl"
					>
						{boston.plate.dias}
					</span>
					<span
						class="mt-3 text-kicker font-semibold uppercase tracking-kicker text-gold"
					>
						{boston.plate.periodo}
					</span>
				</div>
			)}
		</div>
		<figcaption class="sr-only">{boston.datas}</figcaption>
	</figure>

	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		{/* Timeline rail — the section's structural signature. */}
		{agenda && agenda.length > 0 && (
			<div class="mt-block">
				<h3
					id="boston-agenda-title"
					class="text-kicker font-semibold uppercase tracking-kicker text-text-muted"
				>
					Agenda dos 3 dias
				</h3>

				{/*
					Pinned rail. Above 900px the section holds while the three days —
					and the panel that says what they leave behind — travel sideways;
					the gold hairline underneath reads as the progress of the trip.
					Below that, and under reduced motion, the panels stack and are read
					by scrolling the page like everything else: an agenda should not
					ask the reader to find a sideways gesture first. Both states are
					laid out in global.css; motion.ts only adds `is-pinned` and writes
					the reserved height, so the page never shifts when the rail
					engages.
				*/}
				<div class="mt-8" data-hpin>
					<div data-hpin-vp>
						<ol data-hpin-track>
							{agenda.map((d) => (
								<li
									class="relative flex flex-col border-t-2 border-crimson-mid-45 bg-[color-mix(in_srgb,var(--color-ink-raised)_55%,transparent)] p-6 pt-7 lg:p-8 lg:pt-9"
								>
									<span
										class="absolute -top-[5px] left-0 h-2 w-2 rounded-full"
										style="background-color: var(--color-crimson-bright);"
										aria-hidden="true"></span>

									<div class="flex items-baseline justify-between gap-3">
										<span
											class="font-sans text-2xl font-bold tracking-tight tabular-nums text-text-primary"
										>
											Dia {d.dia}
										</span>
										<span
											class="text-kicker uppercase tracking-kicker tabular-nums text-text-muted"
										>
											{d.data}
										</span>
									</div>

									<h4
										class="mt-3 font-display text-h3 font-semibold leading-snug text-text-primary"
									>
										{d.titulo}
									</h4>
									<p class="mt-2 text-body text-text-secondary">{d.descricao}</p>

									<ul class="mt-5 space-y-2.5">
										{d.atividades.map((a) => (
											<li class="flex items-start gap-2.5 text-meta text-text-secondary">
												<Icon
													name="chevron-right"
													size={14}
													strokeWidth={2.25}
													class="mt-1 shrink-0 text-gold/60"
													aria-hidden="true"
												/>
												<span>{a}</span>
											</li>
										))}
									</ul>
								</li>
							))}

							{boston.ctaCard && ctaCardHref && (
								<li
									class="relative flex flex-col justify-center border border-[color-mix(in_srgb,var(--color-gold)_34%,transparent)] p-6 lg:p-8"
									style="background: linear-gradient(180deg, color-mix(in srgb, var(--color-ink-raised) 94%, transparent), color-mix(in srgb, var(--color-ink) 92%, transparent));"
								>
									<div
										class="pointer-events-none absolute inset-0 opacity-40"
										aria-hidden="true"
										style="background: radial-gradient(circle at 70% 15%, color-mix(in srgb, var(--color-gold) 22%, transparent) 0%, transparent 62%);"
									>
									</div>
									<div class="relative">
										<p
											class="text-kicker font-semibold uppercase tracking-kicker text-gold"
										>
											{boston.ctaCard.kicker}
										</p>
										<p
											class="mt-4 font-display text-[clamp(1.1875rem,1.6vw,1.5625rem)] font-semibold leading-snug text-text-primary"
										>
											{boston.ctaCard.texto}
										</p>
										<button
											type="button"
									data-lead-cta="boston"
									data-whatsapp-url={ctaCardHref}
									class="group mt-7 inline-flex min-h-[52px] items-center justify-center gap-3 rounded-full bg-gold px-6 font-semibold text-ink-deep shadow-(--shadow-halo-gold) transition-transform duration-300 hover:scale-[1.02] focus-visible:scale-[1.02]"
										>
											<span>{boston.ctaCard.cta.label}</span>
											<Icon
												name="arrow-right"
												size={18}
												strokeWidth={2.25}
												class="transition-transform duration-300 group-hover:translate-x-1"
											/>
										</button>
									</div>
								</li>
							)}
						</ol>

						<div data-hpin-rail aria-hidden="true">
							<span data-hpin-bar></span>
						</div>
					</div>
				</div>
			</div>
		)}

		{/* Stat band */}
		{boston.freshStats && boston.freshStats.length === 3 && (
			<div
				class="mt-block grid grid-cols-1 gap-y-8 border-t border-[color-mix(in_srgb,var(--color-gold)_18%,transparent)] pt-block sm:grid-cols-3 sm:gap-x-10"
				aria-label="Diferenciais de Fresh Specimens"
			>
				{boston.freshStats.map((stat) => {
					const parts = splitStat(stat.valor);
					return (
					<div
						class="flex flex-col items-start gap-2"
					>
						<span
							class="font-display text-5xl font-extrabold leading-none tracking-tight tabular-nums text-text-primary sm:text-6xl"
						>
							{/* Single line on purpose: Astro templates are HTML-semantic, so
							    breaking this fragment across lines injects a real space and
							    renders "≤ 48 h" / "100 %" instead of "≤ 48h" / "100%". */}
							{parts ? (
								<>{parts.prefix}<span data-count={parts.numero}>{parts.numero}</span>{parts.suffix}</>
							) : (
								stat.valor
							)}
						</span>
						<span
							class="text-kicker font-semibold uppercase tracking-kicker text-text-muted"
						>
							{stat.rotulo}
						</span>
					</div>
					);
				})}
			</div>
		)}
	</div>
</section>
