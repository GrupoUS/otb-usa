---
import type { CollectionEntry } from "astro:content";
import Icon, { type IconName } from "../icons/Icon.astro";

type ProductData = CollectionEntry<"products">["data"];

export interface Props {
	bostonHarvard: ProductData["bostonHarvard"];
	agenda?: ProductData["agenda"];
}

const { bostonHarvard, agenda } = Astro.props;

const cardIcons: IconName[] = ["microscope", "graduation-cap", "users"];
---

<section
	id="boston-harvard"
	class="relative isolate overflow-hidden py-28 sm:py-32"
	aria-labelledby="boston-heading"
>
	<div
		class="absolute inset-0 -z-10 opacity-[0.15]"
		aria-hidden="true"
		style={`background-image: linear-gradient(180deg, color-mix(in srgb, var(--color-navy) 88%, transparent) 0%, var(--color-navy) 95%), url('${bostonHarvard.background.image}'); background-size: cover; background-position: center;`}
	>
	</div>

	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="max-w-3xl" data-reveal="up">
			<span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.32em] text-gold">
				<span class="h-px w-10 bg-gold/60"></span>
				Imersão internacional
			</span>
			<h2
				id="boston-heading"
				class="mt-5 font-serif text-3xl font-bold leading-[1.1] tracking-tight sm:text-4xl md:text-5xl"
			>
				<span class="text-text-primary">{bostonHarvard.headline}</span>
				{bostonHarvard.highlight && (
					<span class="mt-2 block text-gradient-gold">{bostonHarvard.highlight}</span>
				)}
			</h2>
			<p class="mt-6 max-w-2xl text-base leading-relaxed text-text-muted sm:text-lg">
				{bostonHarvard.descricao}
			</p>

			<div class="mt-8 inline-flex items-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--color-gold)_30%,transparent)] bg-[color-mix(in_srgb,var(--color-navy-light)_70%,transparent)] px-4 py-2 text-xs uppercase tracking-[0.2em] text-text-primary/80">
				<Icon name="calendar" size={14} strokeWidth={2} class="text-gold" />
				{bostonHarvard.datas}
			</div>
		</div>

		<div class="mt-16 grid grid-cols-1 gap-6 lg:grid-cols-3">
			{bostonHarvard.cards.map((card, idx) => (
				<article
					class="glass-card card-glow-hover relative rounded-2xl p-7"
					data-reveal="up"
					data-reveal-delay={String(idx + 2)}
				>
					<div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl border border-[color-mix(in_srgb,var(--color-gold)_35%,transparent)] bg-[color-mix(in_srgb,var(--color-gold)_10%,transparent)] text-gold">
						<Icon name={cardIcons[idx] ?? "sparkles"} size={22} strokeWidth={1.75} />
					</div>
					<h3 class="font-serif text-lg font-semibold leading-tight text-text-primary">
						{card.titulo}
					</h3>
					<p class="mt-3 text-sm leading-relaxed text-text-muted">{card.descricao}</p>
				</article>
			))}
		</div>

		{agenda && agenda.length > 0 && (
			<div class="mt-20" aria-label="Agenda de 3 dias em Boston">
				<div class="mb-8 flex items-center gap-3" data-reveal="up">
					<Icon name="calendar" size={18} strokeWidth={2} class="text-gold" />
					<span class="text-[11px] font-semibold uppercase tracking-[0.32em] text-gold">
						Agenda dos 3 dias
					</span>
				</div>
				<ol class="grid grid-cols-1 gap-5 lg:grid-cols-3">
					{agenda.map((d, idx) => (
						<li
							class="relative rounded-2xl border border-[color-mix(in_srgb,var(--color-gold)_22%,transparent)] bg-[color-mix(in_srgb,var(--color-navy-light)_55%,transparent)] p-6"
							data-reveal="up"
							data-reveal-delay={String(idx + 2)}
						>
							<div class="flex items-baseline justify-between gap-3">
								<span class="font-serif text-3xl font-bold text-gradient-gold tabular-nums">
									Dia {d.dia}
								</span>
								<span class="text-[11px] uppercase tracking-[0.22em] text-gold/80">
									{d.data}
								</span>
							</div>
							<h3 class="mt-3 font-serif text-base font-semibold leading-snug text-text-primary">
								{d.titulo}
							</h3>
							<p class="mt-2 text-sm leading-relaxed text-text-muted">{d.descricao}</p>
							<ul class="mt-4 space-y-2">
								{d.atividades.map((a) => (
									<li class="flex items-start gap-2 text-sm leading-snug text-text-primary/85">
										<Icon
											name="chevron-right"
											size={14}
											strokeWidth={2.25}
											class="mt-1 shrink-0 text-gold/60"
											aria-hidden="true"
										/>
										<span>{a}</span>
									</li>
								))}
							</ul>
						</li>
					))}
				</ol>
			</div>
		)}
	</div>
</section>
