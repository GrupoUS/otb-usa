---
import type { CollectionEntry } from "astro:content";
import SectionHeader from "./SectionHeader.astro";

export interface Props {
	modulos: CollectionEntry<"products">["data"]["modulos"];
}

const { modulos } = Astro.props;
---

{/*
	Numbered index, book-contents style. Deliberately photo-free and box-free:
	it lands right after the gallery, and the dry typographic contrast is what
	makes the photography read as dominant. Ten bordered cards read as a wall;
	ten hairline rows read in a third of the time.
*/}
<section
	id="modulos"
	class="band-base relative py-section-tight"
	aria-labelledby="modulos-heading"
>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<SectionHeader
			headingId="modulos-heading"
			numeral="06"
			kicker="Trilha online"
			headline={modulos.headline}
			highlight={modulos.highlight}
			descricao={modulos.descricao}
		/>

		<ol
			class="mt-block grid grid-cols-1 border-t border-[color-mix(in_srgb,var(--color-gold)_16%,transparent)] md:grid-cols-2 md:gap-x-12"
		>
			{modulos.lista.map((m, idx) => (
				<li
					class="group relative border-b border-[color-mix(in_srgb,var(--color-gold)_16%,transparent)]"
					data-reveal="up"
					data-reveal-delay={String(Math.min(idx + 1, 10))}
				>
					{/* Left rule grows on hover — this section's only micro-interaction. */}
					<span
						class="absolute left-0 top-0 h-full w-[2px] origin-top scale-y-0 bg-gold transition-transform duration-300 group-hover:scale-y-100"
						aria-hidden="true"></span>
					<div
						class="flex min-h-[72px] items-baseline gap-5 py-5 pl-4 transition-colors duration-200 group-hover:bg-[color-mix(in_srgb,var(--color-gold)_5%,transparent)]"
					>
						<span
							class="w-9 shrink-0 font-sans text-lg font-bold leading-none tabular-nums text-gold/60 transition-colors duration-200 group-hover:text-gold"
						>
							{m.numero}
						</span>
						<div class="min-w-0">
							<h3 class="text-body font-semibold text-text-primary">
								{m.titulo}
							</h3>
							{m.subtitulo && (
								<p class="mt-1 text-meta text-text-secondary">{m.subtitulo}</p>
							)}
						</div>
					</div>
				</li>
			))}
		</ol>
	</div>
</section>
