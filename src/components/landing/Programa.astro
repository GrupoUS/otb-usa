---
import type { CollectionEntry } from "astro:content";
import Icon, { type IconName } from "../icons/Icon.astro";
import SectionHeader from "./SectionHeader.astro";

export interface Props {
	programa: CollectionEntry<"products">["data"]["programa"];
}

const { programa } = Astro.props;

const cardIcons: IconName[] = ["graduation-cap", "globe", "microscope"];
---

{/*
	Syllabus, not a feature grid. The three cards became hairline spec rows:
	numeral · icon · title · description. The 320h figure is this section's one
	gold moment and is sized to be read from across the room.
*/}
<section
	id="programa"
	class="band-base relative py-section"
	aria-labelledby="programa-heading"
>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-16">
			<div class="lg:col-span-5" data-reveal="left">
				<SectionHeader
					headingId="programa-heading"
					numeral="04"
					kicker="Programa completo"
					headline={programa.headline}
					highlight={programa.highlight}
					descricao={programa.descricao}
				/>

				{programa.narrativa && (
					<blockquote
						class="mt-8 max-w-xl border-l-2 border-gold pl-6 font-display text-h3 leading-snug text-text-primary"
						data-reveal="up"
						data-reveal-delay="1"
					>
						{programa.narrativa}
					</blockquote>
				)}

				<div
					class="mt-10 flex items-baseline gap-3 tabular-nums"
					data-reveal="up"
					data-reveal-delay="2"
				>
					{/* Server-rendered at its final value; `data-count` only replays
					    it as a count-up once scrolled into view (and never under
					    prefers-reduced-motion). */}
					<span
						class="font-display text-6xl font-extrabold tracking-tight text-gradient-gold sm:text-7xl"
						data-count={programa.horas}
					>
						{programa.horas}
					</span>
					<div class="flex flex-col gap-0.5">
						<span class="text-sm uppercase tracking-[0.18em] text-text-secondary">
							horas
						</span>
						<span class="text-kicker uppercase tracking-kicker text-text-muted">
							de formação executiva
						</span>
					</div>
				</div>

				{/* Scale rail. Four figures that answer "how much of what" before the
				    reader reaches the syllabus column. */}
				{/* Two columns again at `lg`: from that breakpoint this rail lives
				    inside the 5/12 column, where four tracks measure ~99px — and
				    "Certificações" alone is 139px once the kicker's 0.28em tracking
				    is applied to 13 uppercase characters it cannot break. The label
				    spilled into the neighbour and the two words rendered on top of
				    each other. Four tracks are only safe while the rail is full-width. */}
				{programa.kpis && programa.kpis.length > 0 && (
					<dl
						class="mt-9 grid grid-cols-2 gap-6 border-t border-[color-mix(in_srgb,var(--color-gold)_18%,transparent)] pt-7 tabular-nums sm:grid-cols-4 lg:grid-cols-2"
						data-reveal="up"
						data-reveal-delay="3"
					>
						{programa.kpis.map((kpi) => (
							<div>
								<dd
									class="m-0 font-display text-3xl font-extrabold tracking-tight text-text-primary"
								>
									<span data-count={kpi.valor}>{kpi.valor}</span>{kpi.sufixo}
								</dd>
								<dt
									class="mt-2 text-kicker font-semibold uppercase tracking-kicker text-text-muted"
								>
									{kpi.rotulo}
								</dt>
							</div>
						))}
					</dl>
				)}
			</div>

			<div class="lg:col-span-7">
				<dl
					class="divide-y divide-[color-mix(in_srgb,var(--color-gold)_16%,transparent)] border-y border-[color-mix(in_srgb,var(--color-gold)_16%,transparent)]"
				>
					{programa.cards.map((card, idx) => (
						<div
							class="group grid grid-cols-[auto_1fr] gap-x-5 gap-y-2 py-7 transition-colors duration-200 sm:gap-x-7"
							data-reveal="up"
							data-reveal-delay={String(idx + 2)}
						>
							<span
								class="font-sans text-2xl font-bold leading-none tabular-nums text-gold/45 transition-colors duration-200 group-hover:text-gold/80"
								aria-hidden="true"
							>
								{String(idx + 1).padStart(2, "0")}
							</span>
							<dt
								class="flex items-center gap-3 font-display text-h3 font-semibold text-text-primary"
							>
								<Icon
									name={cardIcons[idx] ?? "sparkles"}
									size={18}
									strokeWidth={1.75}
									class="shrink-0 text-gold"
									aria-hidden="true"
								/>
								{card.titulo}
							</dt>
							<dd class="col-start-2 text-body text-text-secondary">
								{card.descricao}
							</dd>
						</div>
					))}
				</dl>
			</div>
		</div>
	</div>
</section>
