---
import type { CollectionEntry } from "astro:content";
import Icon, { type IconName } from "../icons/Icon.astro";

export interface Props {
	programa: CollectionEntry<"products">["data"]["programa"];
}

const { programa } = Astro.props;

const cardIcons: IconName[] = ["graduation-cap", "globe", "microscope"];
---

<section id="programa" class="relative py-28 sm:py-32" aria-labelledby="programa-heading">
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
			<div class="lg:col-span-5" data-reveal="left">
				<span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.32em] text-gold">
					<span class="h-px w-10 bg-gold/60"></span>
					Programa completo
				</span>
				<h2
					id="programa-heading"
					class="mt-5 font-serif text-3xl font-bold leading-[1.1] tracking-tight sm:text-4xl md:text-5xl"
				>
					<span class="text-text-primary">{programa.headline}</span>
					{programa.highlight && (
						<span class="mt-2 block text-gradient-gold">{programa.highlight}</span>
					)}
				</h2>
				<p class="mt-6 max-w-xl text-base leading-relaxed text-text-muted sm:text-lg">
					{programa.descricao}
				</p>

				<div class="mt-10 inline-flex items-baseline gap-3 rounded-2xl border border-[color-mix(in_srgb,var(--color-gold)_30%,transparent)] bg-[color-mix(in_srgb,var(--color-navy-light)_70%,transparent)] px-6 py-4 tabular-nums">
					<span class="font-serif text-5xl font-bold text-gradient-gold">{programa.horas}</span>
					<span class="text-sm uppercase tracking-[0.18em] text-text-muted">horas</span>
				</div>
			</div>

			<div class="lg:col-span-7">
				<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
					{programa.cards.map((card: { titulo: string; descricao: string }, idx: number) => (
						<article
							class="glass-card card-hover-lift relative rounded-2xl p-7"
							class:list={[idx === 2 && "sm:col-span-2"]}
							data-reveal="up"
							data-reveal-delay={String(idx + 2)}
						>
							<div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl border border-[color-mix(in_srgb,var(--color-gold)_35%,transparent)] bg-[color-mix(in_srgb,var(--color-gold)_10%,transparent)] text-gold">
								<Icon name={cardIcons[idx] ?? "sparkles"} size={20} strokeWidth={1.75} />
							</div>
							<h3 class="font-serif text-xl font-semibold text-text-primary">{card.titulo}</h3>
							<p class="mt-3 text-sm leading-relaxed text-text-muted">{card.descricao}</p>
						</article>
					))}
				</div>
			</div>
		</div>
	</div>
</section>
