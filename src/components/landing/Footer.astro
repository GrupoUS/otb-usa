---
import type { CollectionEntry } from "astro:content";
import { defaultWhatsAppUrl } from "../../lib/whatsapp";
import Icon from "../icons/Icon.astro";

export interface Props {
	legal: CollectionEntry<"products">["data"]["legal"];
	footer?: CollectionEntry<"products">["data"]["footer"];
}

const { legal, footer } = Astro.props;
const whatsappHref = defaultWhatsAppUrl();
const currentYear = new Date().getFullYear();
---

<footer
	class="band-deep relative border-t border-[color-mix(in_srgb,var(--color-gold)_18%,transparent)]"
>
	<div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
		<div class="grid grid-cols-1 gap-12 md:grid-cols-12">
			<div class="md:col-span-5">
				<a href="#topo" class="inline-flex items-center gap-3" aria-label="OTB — Voltar ao topo">
					<img
						src="/images/otb/otb-logo-gold-176.png"
						srcset="/images/otb/otb-logo-gold-176.png 1x, /images/otb/otb-logo-gold-352.png 2x"
						alt="Logo OTB em dourado."
						width="176"
						height="97"
						loading="lazy"
						fetchpriority="low"
						decoding="async"
						class="h-11 w-auto object-contain"
					/>
					<span class="font-display text-2xl font-semibold text-text-primary">OTB</span>
				</a>
				{footer?.resumo && (
					<p class="mt-5 max-w-md text-body text-text-secondary">
						{footer.resumo}
					</p>
				)}
				{footer?.sede && (
					<div class="mt-6 flex items-center gap-3 text-kicker uppercase tracking-kicker text-text-muted">
						<Icon name="map-pin" size={14} strokeWidth={2} class="text-gold" />
						{footer.sede}
					</div>
				)}
			</div>

			{footer?.nav && (
				<nav class="md:col-span-4" aria-label="Seções da página">
					<div class="text-kicker uppercase tracking-kicker text-text-muted">{footer.navTitulo}</div>
					<ul class="mt-5 grid grid-cols-2 gap-x-3 text-meta text-text-secondary">
						{footer.nav.map((item) => (
							<li>
								<a class="inline-flex min-h-11 items-center transition-colors hover:text-gold" href={item.href}>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			)}

			{footer && (
				<div class="md:col-span-3">
					<div class="text-kicker uppercase tracking-kicker text-text-muted">{footer.contatoTitulo}</div>
					<p class="mt-5 text-meta text-text-secondary">
						{footer.contatoTexto}
					</p>
					<button
						type="button"
						data-lead-cta="footer"
						data-whatsapp-url={whatsappHref}
						class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--color-gold)_40%,transparent)] px-4 py-2.5 text-sm font-medium text-text-primary transition-colors hover:border-gold hover:text-gold"
						aria-label={`${footer.contatoLabel} com Laura`}
					>
						<Icon name="message-circle" size={14} strokeWidth={2.25} />
						{footer.contatoLabel}
					</button>
				</div>
			)}
		</div>

		<div class="mt-14 border-t border-[color-mix(in_srgb,var(--color-gold)_12%,transparent)] pt-8">
			<p class="max-w-3xl wrap-break-word text-meta leading-relaxed text-text-muted">
				{legal.disclaimer}
			</p>
			{legal.creditosImagens && (
				<p class="mt-3 max-w-3xl wrap-break-word text-meta leading-relaxed text-text-muted">{legal.creditosImagens}</p>
			)}
			<p class="mt-6 flex items-center gap-2 text-meta text-text-muted">
				<span class="inline-block h-1.5 w-1.5 rounded-full bg-gold-tint-10 border border-gold-mid-35" aria-hidden="true"></span>
				© {currentYear} Grupo US — Todos os direitos reservados.
			</p>
		</div>
	</div>
</footer>
