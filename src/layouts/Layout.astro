---
import { Font } from "astro:assets";
import ScrollProgress from "../components/landing/ScrollProgress.astro";
import "../styles/global.css";

export interface Props {
	title: string;
	description: string;
	ogImage?: string;
	canonical?: string;
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
	title,
	description,
	ogImage = "/og/otb-default.jpg",
	canonical,
	jsonLd,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const pageUrl =
	canonical ??
	new URL(
		Astro.url.pathname,
		Astro.site ?? "https://otb.gpus.com.br",
	).toString();
const absoluteOgImage = ogImage.startsWith("http")
	? ogImage
	: `${site}${ogImage}`;

const organizationJsonLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "Grupo US",
	url: site || "https://otb.gpus.com.br",
	logo: `${site}/images/otb/otb-logo-gold.png`,
	sameAs: [] as string[],
	contactPoint: {
		"@type": "ContactPoint",
		telephone: "+556294705081",
		contactType: "sales",
		areaServed: "BR",
		availableLanguage: ["pt-BR"],
	},
};

const jsonLdPayload = jsonLd
	? Array.isArray(jsonLd)
		? [organizationJsonLd, ...jsonLd]
		: [organizationJsonLd, jsonLd]
	: organizationJsonLd;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<script is:inline>document.documentElement.classList.add("js");</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{/* meta theme-color cannot read CSS variables; literal MUST mirror --color-navy in src/styles/global.css @theme. Keep in sync if the navy token changes. */}
		<meta name="theme-color" content="#1a1a2e" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={pageUrl} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
		<link rel="alternate icon" href="/favicon.ico" />

		{/* Astro Fonts API — injects @font-face with font-display: swap.
		    Sora is the LCP font (h1 / display headings) → preload.
		    Inter is body copy → swap-only is enough; no preload (saves bytes). */}
		<Font cssVariable="--font-sora" preload />
		<Font cssVariable="--font-inter" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteOgImage} />
		<meta property="og:url" content={pageUrl} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteOgImage} />

		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdPayload)}></script>
	</head>

	<body>
		<a class="skip-link" href="#conteudo-principal">Pular para o conteúdo</a>

		<ScrollProgress />

		<slot name="header" />

		{/* Drives the header solid state. Positioned absolutely at the top of the
		    page so it has a real box to observe without occupying flow. */}
		<div
			id="header-sentinel"
			class="pointer-events-none absolute top-0 left-0 h-px w-px"
			aria-hidden="true">
		</div>

		<main id="conteudo-principal" tabindex="-1">
			<slot />
		</main>

		<slot name="floating" />

		<script>
			import { initMotion } from "../scripts/motion";

			const revealAll = (items: NodeListOf<HTMLElement>) => {
				items.forEach((el) => el.classList.add("revealed"));
			};

			const initReveal = () => {
				const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
				if (!items.length) return;

				if (typeof IntersectionObserver === "undefined") {
					revealAll(items);
					return;
				}

				try {
					const observer = new IntersectionObserver(
						(entries, obs) => {
							for (const entry of entries) {
								if (entry.isIntersecting) {
									entry.target.classList.add("revealed");
									obs.unobserve(entry.target);
								}
							}
						},
						{ rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
					);

					items.forEach((el) => observer.observe(el));
				} catch {
					// Degrade gracefully if IO constructor throws (hardened
					// WebViews, privacy modes, legacy browsers): reveal everything.
					revealAll(items);
				}
			};

			const boot = () => {
				initReveal();
				try {
					initMotion();
				} catch {
					// Count-up / parallax / tilt are enhancements on markup that is
					// already complete — never let them take the reveal down with them.
				}
			};

			try {
				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", boot, { once: true });
				} else {
					boot();
				}
			} catch {
				// Last-resort guard: never leave content invisible.
				document
					.querySelectorAll<HTMLElement>("[data-reveal]")
					.forEach((el) => el.classList.add("revealed"));
			}
		</script>
	</body>
</html>
