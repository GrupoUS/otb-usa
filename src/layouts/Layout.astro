---
import { Font } from "astro:assets";
import ScrollProgress from "../components/landing/ScrollProgress.astro";
import "../styles/global.css";

export interface Props {
	title: string;
	description: string;
	ogImage?: string;
	canonical?: string;
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
	title,
	description,
	ogImage = "/og/otb-default.jpg",
	canonical,
	jsonLd,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const pageUrl =
	canonical ??
	new URL(
		Astro.url.pathname,
		Astro.site ?? "https://otb.gpus.com.br",
	).toString();
const absoluteOgImage = ogImage.startsWith("http")
	? ogImage
	: `${site}${ogImage}`;

const organizationJsonLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "Grupo US",
	url: site || "https://otb.gpus.com.br",
	logo: `${site}/images/otb/otb-logo-gold.png`,
	sameAs: [] as string[],
	contactPoint: {
		"@type": "ContactPoint",
		telephone: "+556294705081",
		contactType: "sales",
		areaServed: "BR",
		availableLanguage: ["pt-BR"],
	},
};

const jsonLdPayload = jsonLd
	? Array.isArray(jsonLd)
		? [organizationJsonLd, ...jsonLd]
		: [organizationJsonLd, jsonLd]
	: organizationJsonLd;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<!-- Google Tag Manager -->
		<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-MVQW6VLD');</script>
		<!-- End Google Tag Manager -->
		<script is:inline>document.documentElement.classList.add("js");</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{/* meta theme-color cannot read CSS variables; literal MUST mirror --color-navy in src/styles/global.css @theme. Keep in sync if the navy token changes. */}
		<meta name="theme-color" content="#1a1a2e" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={pageUrl} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
		<link rel="alternate icon" href="/favicon.ico" />

		{/* Astro Fonts API — injects @font-face with font-display: swap and
		    metric-matched fallbacks (size-adjust / ascent-override).

		    BOTH faces are preloaded. The metric overrides keep line HEIGHT stable
		    across the swap, but they cannot keep line COUNT stable: per-glyph
		    advances still differ, so a wrapped headline or label can gain a line
		    when the real face lands. The hero is taller than the fold on a phone,
		    which means its height is content-driven — so that reflow drags the
		    full-bleed plate behind it and shows up as CLS. Preloading Inter (48KB)
		    buys ~0.05 of CLS back; measured against the LCP photograph it costs
		    nothing noticeable. Revisit if the hero ever fits inside 100svh again. */}
		<Font cssVariable="--font-sora" preload />
		<Font cssVariable="--font-inter" preload />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteOgImage} />
		<meta property="og:url" content={pageUrl} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteOgImage} />

		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdPayload)}></script>
	</head>

	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MVQW6VLD"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<a class="skip-link" href="#conteudo-principal">Pular para o conteúdo</a>

		<ScrollProgress />

		<slot name="header" />

		<main id="conteudo-principal" tabindex="-1">
			<slot />
		</main>

		<slot name="floating" />

		<script>
			import { initMotion } from "../scripts/motion";

			const revealAll = (items: NodeListOf<HTMLElement>) => {
				items.forEach((el) => el.classList.add("revealed"));
			};

			const initReveal = () => {
				const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
				if (!items.length) return;

				if (typeof IntersectionObserver === "undefined") {
					revealAll(items);
					return;
				}

				try {
					const observer = new IntersectionObserver(
						(entries, obs) => {
							for (const entry of entries) {
								if (entry.isIntersecting) {
									entry.target.classList.add("revealed");
									obs.unobserve(entry.target);
								}
							}
						},
						{ rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
					);

					items.forEach((el) => observer.observe(el));
				} catch {
					// Degrade gracefully if IO constructor throws (hardened
					// WebViews, privacy modes, legacy browsers): reveal everything.
					revealAll(items);
				}
			};

			const boot = () => {
				initReveal();
				try {
					initMotion();
				} catch {
					// Count-up / parallax / tilt are enhancements on markup that is
					// already complete — never let them take the reveal down with them.
				}
			};

			try {
				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", boot, { once: true });
				} else {
					boot();
				}
			} catch {
				// Last-resort guard: never leave content invisible.
				document
					.querySelectorAll<HTMLElement>("[data-reveal]")
					.forEach((el) => el.classList.add("revealed"));
				document
					.querySelectorAll<HTMLElement>("[data-enter]")
					.forEach((el) => el.classList.add("entered"));
			}
		</script>
	</body>
</html>
