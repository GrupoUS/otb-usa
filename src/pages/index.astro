---
import { getEntry } from "astro:content";
import Aplicacao from "../components/landing/Aplicacao.astro";
import Boston from "../components/landing/Boston.astro";
import Certificacoes from "../components/landing/Certificacoes.astro";
import FAQ from "../components/landing/FAQ.astro";
import FinalCta from "../components/landing/FinalCta.astro";
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import Hero from "../components/landing/Hero.astro";
import Investimento from "../components/landing/Investimento.astro";
import LeadFormDialog from "../components/landing/LeadFormDialog.astro";
import Modulos from "../components/landing/Modulos.astro";
import Parceiros from "../components/landing/Parceiros.astro";
import Programa from "../components/landing/Programa.astro";
import Speakers from "../components/landing/Speakers.astro";
import StickyCta from "../components/landing/StickyCta.astro";
import TargetAudience from "../components/landing/TargetAudience.astro";
import Transparencia from "../components/landing/Transparencia.astro";
import Turmas from "../components/landing/Turmas.astro";
import Virada from "../components/landing/Virada.astro";
import WhatsAppFloatingButton from "../components/landing/WhatsAppFloatingButton.astro";
import WhyOTB from "../components/landing/WhyOTB.astro";
import Layout from "../layouts/Layout.astro";

const otb = await getEntry("products", "otb");
if (!otb) {
	throw new Error(
		"Content collection 'products' missing entry 'otb'. Verify src/content/products/otb.json.",
	);
}

const { data } = otb;

const canonicalUrl = new URL(
	"/",
	Astro.site ?? "https://otb.gpus.com.br",
).toString();

const loteAtivo = data.lotes?.find((lote) => lote.status === "ativo");
const loteAtivoLabel = loteAtivo?.label.replace(/\s*—\s*Ativo$/i, "");
const stickyInfo = loteAtivo
	? `${loteAtivoLabel} · ${loteAtivo.moeda} ${loteAtivo.preco}`
	: `${data.investimento.moeda} ${data.investimento.preco}`;

/* Hero edition rail. Composed here from existing SSOT fields rather than a
   dedicated JSON block, so it can never disagree with the lote table rendered
   further down the page. */
const heroFicha = [
	...(data.edicao
		? [
				{
					rotulo: "Edição",
					valor: `${String(data.edicao.numero).padStart(2, "0")} · ${data.edicao.ano}`,
				},
			]
		: []),
	{ rotulo: "Carga horária", valor: `${data.programa.horas} horas` },
	...(loteAtivo
		? [
				{
					rotulo: `${loteAtivoLabel} ativo`,
					prefixo: loteAtivo.moeda,
					valor: loteAtivo.preco,
					destaque: true,
				},
			]
		: []),
];

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Início",
			item: canonicalUrl,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "MBA em Business Aesthetic Health",
			item: canonicalUrl,
		},
	],
};
---

<Layout
	title={data.seo.title}
	description={data.seo.description}
	ogImage={data.seo.ogImage}
	canonical={canonicalUrl}
	jsonLd={breadcrumbJsonLd}
>
	{data.header && (
		<Header
			slot="header"
			header={data.header}
			whatsappMessage={data.hero.cta.whatsappMessage}
		/>
	)}

	{/*
		No dividers between sections: the tonal band change (band-base ↔
		band-alt ↔ band-deep) is the separator now. A hairline between every
		pair of sections just made a long dark page look striped.
	*/}
	<Hero hero={data.hero} ficha={heroFicha} countdown={data.countdown} />
	{data.certificacoes && <Certificacoes certificacoes={data.certificacoes} />}
	{data.virada && <Virada virada={data.virada} />}
	<WhyOTB why={data.why} />
	<TargetAudience audience={data.audience} />
	<Programa programa={data.programa} />
	<Turmas turmas={data.turmas} />
	<Modulos modulos={data.modulos} />
	<Boston boston={data.boston} agenda={data.agenda} />
	<Speakers speakers={data.speakers} />
	<Investimento
		investimento={data.investimento}
		lotes={data.lotes}
		countdown={data.countdown}
	/>
	{data.aplicacao && (
		<Aplicacao aplicacao={data.aplicacao} leadForm={data.leadForm} />
	)}
	{data.parceiros && <Parceiros parceiros={data.parceiros} />}
	<FAQ faq={data.faq} faqIntro={data.faqIntro} />
	{data.transparencia && <Transparencia transparencia={data.transparencia} />}
	{data.finalCta && <FinalCta finalCta={data.finalCta} />}

	<Footer legal={data.legal} footer={data.footer} />
	<LeadFormDialog leadForm={data.leadForm} />

	<WhatsAppFloatingButton slot="floating" message={data.hero.cta.whatsappMessage} />

	<StickyCta
		slot="floating"
		info={stickyInfo}
		label={data.header?.ctaLabel ?? "Falar com Laura"}
		whatsappMessage={data.investimento.cta.whatsappMessage}
		checkoutUrl={data.investimento.cta.checkoutUrl}
		checkoutLabel={data.investimento.cta.secondaryLabel}
		countdownPrefixo={data.countdown?.stickyPrefixo}
		countdownTarget={data.countdown?.target}
	/>
</Layout>
