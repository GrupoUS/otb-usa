.claude/scheduled_tasks.lock

# Evidências do smoke responsivo (bun run smoke -- --shots)
.smoke/

# graph-powers
.graph-powers/logs/
AGENT_STOP

# Snapshots do instalador (rollback local; nunca versionados)
.claude.bak-*/
AGENTS.md.bak-*

# Gerados com caminhos absolutos desta máquina — .codex/rules/ e o bloco do
