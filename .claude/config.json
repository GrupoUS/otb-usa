{
  "$schema": "./config.schema.json",
  "project": {
    "name": "otb-usa",
    "displayName": "OTB Estados Unidos — Grupo US",
    "parentBrand": "Grupo US · Dra. Sacha Gualberto",
    "purpose": "Landing estática de captação para o OTB — MBA em Business Aesthetic Health com imersão internacional em Boston (3ª edição, 19 a 21 de abril de 2027). Conversão via WhatsApp SDR, sem formulário.",
    "stack": "astro-static-tailwindv4",
    "stagingUrl": "http://localhost:4321",
    "productionUrl": "https://otb.gpus.com.br",
    "locale": "pt-BR",
    "designModelRepo": ""
  },
  "content": {
    "productSlug": "otb",
    "productJson": "src/content/products/otb.json",
    "ogImage": "/og/otb-default.jpg",
    "anchors": [
      "#topo",
      "#por-que-otb",
      "#publico",
      "#programa",
      "#turmas",
      "#modulos",
      "#boston",
      "#speakers",
      "#investimento",
      "#parceiros",
      "#faq"
    ],
    "legalRoutes": [],
    "redirects": {
      "/otb": "/"
    },
    "sections": {
      "hero": "#topo",
      "why": "#por-que-otb",
      "audience": "#publico",
      "programa": "#programa",
      "turmas": "#turmas",
      "modulos": "#modulos",
      "boston": "#boston",
      "speakers": "#speakers",
      "investimento": "#investimento",
      "parceiros": "#parceiros",
      "faq": "#faq"
    },
    "components": {
      "hero": "src/components/landing/Hero.astro",
      "why": "src/components/landing/WhyOTB.astro",
      "audience": "src/components/landing/TargetAudience.astro",
      "programa": "src/components/landing/Programa.astro",
      "turmas": "src/components/landing/Turmas.astro",
      "modulos": "src/components/landing/Modulos.astro",
      "boston": "src/components/landing/Boston.astro",
      "speakers": "src/components/landing/Speakers.astro",
      "investimento": "src/components/landing/Investimento.astro",
      "parceiros": "src/components/landing/Parceiros.astro",
      "faq": "src/components/landing/FAQ.astro",
      "footer": "src/components/landing/Footer.astro",
      "whatsappFloating": "src/components/landing/WhatsAppFloatingButton.astro",
      "layout": "src/layouts/Layout.astro"
    }
  },
  "lead": {
    "leadFlow": "whatsapp-only",
    "sdrName": "Laura",
    "whatsappGreeting": "Olá, Laura!",
    "whatsappHelper": "src/lib/whatsapp.ts",
    "formComponent": "",
    "endpointEnv": "",
    "leadTable": ""
  },
  "tracking": {
    "ga4Env": "PUBLIC_GA4_ID",
    "pixelEnv": "PUBLIC_FB_PIXEL_ID",
    "wired": false
  },
  "paths": {
    "backendRoot": "",
    "frontendRoot": "src",
    "schemaRoot": "src/content.config.ts",
    "stylesRoot": "src/styles",
    "componentsRoot": "src/components",
    "contentRoot": "src/content",
    "libRoot": "src/lib"
  },
  "tooling": {
    "packageManager": "bun",
    "buildTool": "astro",
    "typeChecker": "astro-check",
    "linter": "biome",
    "testRunner": "",
    "deployer": "vercel-static",
    "frontendFramework": "astro+react-islands",
    "database": "",
    "orm": ""
  },
  "gates": {
    "advisory": true,
    "lighthouse": {
      "performance": 95,
      "accessibility": 95,
      "bestPractices": 95,
      "seo": 95
    },
    "lcp": 2500,
    "cls": 0,
    "inp": 200,
    "initialJsKb": 50
  },
  "protectedFiles": {
    "exact": [
      "astro.config.mjs",
      "src/lib/whatsapp.ts",
      "src/content.config.ts",
      "package.json",
      "tsconfig.json",
      "biome.json",
      "lefthook.yml"
    ],
    "segments": [],
    "contains": ["bun.lock"]
  },
  "rulesDir": ".claude/rules",
  "templatesDir": ".claude/templates",
  "agentsFile": "AGENTS.md",
  "claudeMdFile": ".claude/CLAUDE.md"
}
