{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(docker *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(deno *)",
      "Bash(tsc *)",
      "Bash(tsgo *)",
      "Bash(curl *)",
      "Bash(wc *)",
      "Bash(awk *)",
      "Bash(tail *)",
      "Bash(test *)",
      "Read(**/*.json)",
      "Read(**/*.js)",
      "Read(**/*.ts)",
      "Read(**/*.tsx)",
      "Read(**/*.py)",
      "Read(**/*.md)",
      "Read(**/*.css)",
      "Edit(**/*.js)",
      "Edit(**/*.ts)",
      "Edit(**/*.tsx)",
      "Edit(**/*.py)",
      "Edit(**/*.json)",
      "Edit(**/*.css)",
      "Edit(**/*.md)",
      "Write(**/*.js)",
      "Write(**/*.ts)",
      "Write(**/*.tsx)",
      "Write(**/*.py)",
      "Write(**/*.md)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "playwright": true
  },
  "statusLine": {
    "type": "command",
    "command": "python \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/context-monitor.py"
  },
  "plansDirectory": "./docs"
}
